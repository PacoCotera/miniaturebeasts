#!/usr/bin/env python3
"""mb-studio-passwd <user> [--generate]: set a studio user's password (run on the web server with sudo).

Types it twice (12 characters or more), or with --generate shows one five-word passphrase, once.
The hash goes to the users file the login reads (mode 640, root and group mb-login; install.sh sets its path).
Changing a password ends every session of that user: the login compares each session with the hash on every request.
"""
import base64, getpass, grp, hashlib, os, re, secrets, sys
from pathlib import Path

