assert len(WORDS) >= 512 and len(set(WORDS)) == len(WORDS), (len(WORDS), len(set(WORDS)))
WORDS = WORDS[:512]


def make_hash(password, n=2**15, r=8, p=1):
    salt = secrets.token_bytes(16)
    h = hashlib.scrypt(password.encode(), salt=salt, n=n, r=r, p=p, maxmem=2**27, dklen=32)
    b = lambda x: base64.b64encode(x).decode()
    return f"scrypt${n}${r}${p}${b(salt)}${b(h)}"


def write_user(path, user, stored):
    lines = []
    try:
        lines = [l for l in Path(path).read_text("utf-8").splitlines() if l.split(":", 1)[0].strip().lower() != user]
    except FileNotFoundError:
        pass
    lines.append(f"{user}:{stored}")
    os.makedirs(os.path.dirname(path) or ".", mode=0o750, exist_ok=True)
    tmp = path + ".new"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o640)
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(lines) + "\n")
    os.chmod(tmp, 0o640)
    if os.geteuid() == 0:
        try:
            os.chown(tmp, 0, grp.getgrnam("mb-login").gr_gid)
        except KeyError:
            sys.exit("mb-studio-passwd: group mb-login does not exist; run install.sh first")
    os.replace(tmp, path)


def main(argv):
    args = [a for a in argv if not a.startswith("--")]
    if len(args) != 1 or any(a.startswith("--") and a != "--generate" for a in argv):
        sys.exit("usage: mb-studio-passwd <user> [--generate]")
    if PATH.startswith("@"):
        sys.exit("mb-studio-passwd: run the installed copy (install.sh sets the users file's path)")
    user = args[0].lower()
    if not re.fullmatch(r"[a-z0-9._-]{1,32}", user):
        sys.exit("mb-studio-passwd: the user is 1 to 32 letters, digits, . _ -")
    if "--generate" in argv:
        password = "-".join(secrets.choice(WORDS) for _ in range(5))
    else:
        password = getpass.getpass("password (12 characters or more): ")
        if len(password) < 12:
            sys.exit("mb-studio-passwd: 12 characters or more")
        if getpass.getpass("again: ") != password:
            sys.exit("mb-studio-passwd: the two did not match; nothing changed")
    write_user(PATH, user, make_hash(password))
    if "--generate" in argv:
        print(f"{user}'s passphrase, shown once:\n\n    {password}\n")
    print(f"mb-studio-passwd: {user} set; every session of {user} has ended")


if __name__ == "__main__":
    main(sys.argv[1:])
