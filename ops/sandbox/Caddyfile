# The sandbox web server's whole configuration. It ships in every release; deploy.sh checks it with `caddy validate`
# before a release goes live and installs it at /etc/caddy/Caddyfile (a release without this file leaves the installed one alone).
# Owner 2026-11-16: "consolidate all my tools, dashboards, artifacts under /admin. remove /studio we will rebuild that later. and /play for the web play experience".
#   /play/                              the game, wholly: /play/ the play page, /play/station/, /play/exploration/, and their folders (/play/ui/, /play/face/, /play/assets/ ...), built by ops/sandbox/bundle-pages.sh
#                                       (except /play/workbench, /play/caddy and /play/test: the team's tools, 404 here, served only under /admin)
#   /sandbox and /studio                nothing is there: 404 like any address the release does not have
#   /admin/login and /admin/logout      the login (login/mb_login.py, unit mb-login) on 127.0.0.1:8791
#   every other /admin path             only with a session: the login's /check says yes (and names the user), then:
#     /admin/team, team.json ...        the studio's team page, on the private bridge (the studio still answers under its own /studio prefix; this file rewrites to it)
#     /admin/notes*                     the play notes page and files: the Caddy service (not the studio)
#     /admin/bugs                       the bugs page (open bugs, fixed in the last 7 days): the Caddy service, from bugs.json beside the notes; /admin/bugs/summary.json is the index card's live line
#     /admin/book                       the book page (comments, spreads, proof and PDF links): the Caddy service, from book/*.json beside the notes; /admin/book/summary.json is the index card's live line
#     /admin/workbench/                 the species workbench's static files (the release's play/workbench), not public
#     /admin/test/                      the test page (the release's play/test; its links are made absolute by bundle-pages.sh)
#     /admin/ itself                    the index page, from the studio (rewritten to its /index route; /admin redirects to /admin/); its files are /admin/index/*
#     any other /admin path             404, after the login's check
#     The studio sees X-Studio-User only from here, never the browser's cookies, and none of these answers may be kept by a shared cache.
#   /caddy-api/*                        the Caddy service (POST /caddy-api/v1/notes takes a play note; nothing is read back from here); /play/* and the site: the release, static
# Two values come from the web server's environment (install.sh writes them to a file the Caddy unit and deploy.sh both read): MB_ROOT, the
# directory that holds releases/ and current, and MB_STUDIO, the studio's host:port on the private bridge.
# `encode` stays off the studio so nothing buffers its event stream; `route` keeps the header strip ahead of the check.
:80 {
	@admin path /admin /admin/*
	# the species frames (play/workbench/frames/) are game data the Station loads: public; the rest of the workbench is not
	@private {
		path /play/workbench /play/workbench/* /play/caddy /play/caddy/* /play/test /play/test/*
		not path /play/workbench/frames/*
	}
	@teampage path /admin/ /admin/index /admin/index/* /admin/team /admin/team/* /admin/team.json /admin/team-coord.json /admin/team-doc/*

	# the team's tools travel in the release beside the game's folders (the Caddy service and the workbench read their siblings) but are not public: they are served only through /admin below
	handle @private {
		respond "not found" 404
	}
	handle /play {
		redir * /play/ 301
	}
	handle /play/station {
		redir * /play/station/ 301
	}

	handle /admin/login* {
		reverse_proxy 127.0.0.1:8791
	}
	handle /admin/logout {
		reverse_proxy 127.0.0.1:8791
	}
	handle /admin/workbench {
		redir * /admin/workbench/ 302
	}
	# play notes: read only behind the same login, served by the Caddy service on this machine (the notes are on its card, not on the studio's machine);
	# the service answers only with the login's X-Studio-User, and the public /caddy-api/ route below can post a note but never read one
	@caddypages path /admin/notes* /admin/bugs* /admin/book /admin/book/*
	handle @caddypages {
		route {
			request_header -X-Studio-User
			forward_auth 127.0.0.1:8791 {
				uri /check
				copy_headers X-Studio-User
			}
			header X-Robots-Tag noindex
			header Cache-Control "private, no-store"
			reverse_proxy localhost:8787 {
				header_up -Cookie
				header_down -Set-Cookie
			}
		}
	}
	# the page's own links are relative to /admin/, so the address without the slash goes there
	handle /admin {
		redir * /admin/ 302
	}
	# the index page (/admin/ and /admin/index/*) and the team page with its data (team.json, team-coord.json, team-doc/*): the studio on the private bridge answers under its own /studio prefix
	handle @teampage {
		route {
			request_header -X-Studio-User
			forward_auth 127.0.0.1:8791 {
				uri /check
				copy_headers X-Studio-User
			}
			header X-Robots-Tag noindex
			# no shared cache keeps a studio answer (the CDN caches some file types by default and would serve them without the login):
			# "private" goes in front of whatever the studio says, or "private, no-cache" when it says nothing
			header ?Cache-Control "private, no-cache"
			header {
				Cache-Control "^(private, *)?" "private, "
				defer
			}
			# /admin/ is the index page: the studio serves it at /index (its files at /index/<file>)
			@index path /admin/
			rewrite @index /admin/index
			uri path_regexp (?i)^/+admin /studio
			# the session cookie stays here; the studio can set none on the site
			reverse_proxy {$MB_STUDIO} {
				flush_interval -1
				header_up -Cookie
				header_down -Set-Cookie
			}
		}
	}
	handle /admin/test {
		redir * /admin/test/ 302
	}
	# the workbench and the test page: the release's own files (play/workbench, play/test), behind the login
	@tools path /admin/workbench/* /admin/test/*
	handle @tools {
		route {
			request_header -X-Studio-User
			forward_auth 127.0.0.1:8791 {
				uri /check
				copy_headers X-Studio-User
			}
			header X-Robots-Tag noindex
			header Cache-Control "private, no-cache"
			uri path_regexp (?i)^/+admin/(workbench|test) /play/$1
			root * {$MB_ROOT}/current
			encode zstd gzip
			file_server
		}
	}
	# any other /admin path is the login's check, then nothing
	handle @admin {
		route {
			request_header -X-Studio-User
			forward_auth 127.0.0.1:8791 {
				uri /check
				copy_headers X-Studio-User
			}
			header X-Robots-Tag noindex
			header Cache-Control "private, no-store"
			respond "not found" 404
		}
	}
	handle /caddy-api/* {
		reverse_proxy localhost:8787
	}
	handle {
		root * {$MB_ROOT}/current
		encode zstd gzip
		# a master is asked for as <file>?v=<first 12 of its sha256> (station/src/masters.mjs masterUrl): the name changes with the bytes, so the browser and the CDN keep it a year
		@hashed {
			path /play/ui/assets/masters/*
			query v=*
		}
		# the pages' build (prototypes/vite.config.mjs, laid over the site by ops/sandbox/bundle-pages.sh) writes its chunks, styles and pictures to /play/assets/<name>-<content hash>.<ext>: the name changes with the bytes,
		# so they too are kept a year. The pages themselves (/play/, /play/station/ ...) stay no-cache, so a release is seen at the next load.
		@bundled {
			path /play/assets/*
		}
		# one `route`, so the headers apply in the order written: Caddy otherwise sorts header blocks by how specific their matcher is and put
		# /play/*'s no-cache after the hashed master's immutable, so no-cache won; here the generic line comes first and the hashed one overrides it
		route {
			header /build.json Cache-Control "no-store"
			header /play/* Cache-Control "no-cache"
			header @hashed Cache-Control "public, max-age=31536000, immutable"
			header @bundled Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}
}
