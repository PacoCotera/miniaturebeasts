# The sandbox web server's whole configuration. It ships in every release; deploy.sh checks it with `caddy validate`
# before a release goes live and installs it at /etc/caddy/Caddyfile (a release without this file leaves the installed one alone).
#   /studio/login and /studio/logout   the login (login/mb_login.py, unit mb-login) on 127.0.0.1:8791
#   every other /studio path           only with a session: the login's /check says yes (and names the user), then the studio
#                                      on the private bridge answers; the studio sees X-Studio-User only from here, never the
#                                      browser's cookies, and none of its answers may be kept by a shared cache
#   /studio/notes*                     the play notes page and files: the login's check first, then the Caddy service (not the studio)
#   /caddy-api/*                       the Caddy service (POST /caddy-api/v1/notes takes a play note; nothing is read back from here); /sandbox/*, /play/* and the site: the release, static
# Two values come from the web server's environment (install.sh writes them to a file the Caddy unit and deploy.sh both read): MB_ROOT, the
# directory that holds releases/ and current, and MB_STUDIO, the studio's host:port on the private bridge.
# `encode` stays off the studio so nothing buffers its event stream; `route` keeps the header strip ahead of the check.
:80 {
	@studio path /studio /studio/*

	handle /studio/login* {
		reverse_proxy 127.0.0.1:8791
	}
	handle /studio/logout {
		reverse_proxy 127.0.0.1:8791
	}
	# play notes: read only behind the same login, served by the Caddy service on this machine (the notes are on its card, not on the studio's machine);
	# the service answers only with the login's X-Studio-User, and the public /caddy-api/ route below can post a note but never read one
	handle /studio/notes* {
		route {
			request_header -X-Studio-User
			forward_auth 127.0.0.1:8791 {
				uri /check
				copy_headers X-Studio-User
			}
			header X-Robots-Tag noindex
			header Cache-Control "private, no-store"
			reverse_proxy localhost:8787 {
				header_up -Cookie
				header_down -Set-Cookie
			}
		}
	}
	handle @studio {
		route {
			request_header -X-Studio-User
			forward_auth 127.0.0.1:8791 {
				uri /check
				copy_headers X-Studio-User
			}
			header X-Robots-Tag noindex
			# no shared cache keeps a studio answer (the CDN caches some file types by default and would serve them without the login):
			# "private" goes in front of whatever the studio says, or "private, no-cache" when it says nothing
			header ?Cache-Control "private, no-cache"
			header {
				Cache-Control "^(private, *)?" "private, "
				defer
			}
			# the session cookie stays here; the studio can set none on the site
			reverse_proxy {$MB_STUDIO} {
				flush_interval -1
				header_up -Cookie
				header_down -Set-Cookie
			}
		}
	}
	handle /caddy-api/* {
		reverse_proxy localhost:8787
	}
	handle {
		root * {$MB_ROOT}/current
		encode zstd gzip
		# a master is asked for as <file>?v=<first 12 of its sha256> (station/src/masters.mjs masterUrl): the name changes with the bytes, so the browser and the CDN keep it a year
		@hashed {
			path /sandbox/ui/assets/masters/*
			query v=*
		}
		# the pages' build (prototypes/vite.config.mjs, laid over the site by ops/sandbox/bundle-pages.sh) writes its chunks, styles and pictures to /sandbox/assets/<name>-<content hash>.<ext>: the name changes with the bytes,
		# so they too are kept a year. The pages themselves (/sandbox/station/ ...) stay no-cache, so a release is seen at the next load.
		@bundled {
			path /sandbox/assets/*
		}
		# one `route`, so the headers apply in the order written: Caddy otherwise sorts header blocks by how specific their matcher is and put
		# /sandbox/*'s no-cache after the hashed master's immutable, so no-cache won; here the generic line comes first and the hashed one overrides it
		route {
			header /build.json Cache-Control "no-store"
			header /sandbox/* Cache-Control "no-cache"
			header /play/* Cache-Control "no-cache"
			header @hashed Cache-Control "public, max-age=31536000, immutable"
			header @bundled Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}
}
