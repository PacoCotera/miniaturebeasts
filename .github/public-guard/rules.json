{
 "_note": "The public-repository guard's rules (design note: the internal plan public-cleanup.md §4). Each rule: an id, its patterns (JavaScript regular expressions, flags apart) and the file types it applies to. `prose` applies to prose files whole and to comments and strings in code. The allowlist entries are exact paths and values with a reason, printed on every run; a new entry needs the architect's review.",
 "costKeys": [
  "costUSD",
  "balanceCostUSD",
  "remainingBalanceUSD",
  "remaining_balance",
  "balance_cost",
  "credit_cost",
  "spentUSD",
  "spendUSD",
  "totalUSD",
  "usd",
  "balanceAfter",
  "callUSDMean",
  "stationCallUSD",
  "tokenAtSizeUSD",
  "spentAllVersionsUSD",
  "pricing"
 ],
 "costKeyPrefixes": [
  "usdPer"
 ],
 "dataTypes": [
  ".json",
  ".jsonl",
  ".csv"
 ],
 "proseTypes": [
  ".md",
  ".txt",
  ".html"
 ],
 "codeTypes": [
  ".py",
  ".mjs",
  ".js",
  ".cjs",
  ".jsx",
  ".ts",
  ".sh",
  ".lua",
  ".c",
  ".h",
  ".cpp",
  ".yml",
  ".yaml",
  ".toml"
 ],
 "imageTypes": [
  ".png",
  ".jpg",
  ".jpeg",
  ".webp",
  ".gif"
 ],
 "binaryTypes": [
  ".y4m"
 ],
 "rules": [
  {
   "id": "cost-key",
   "applies": "data",
   "builtin": "costKeys"
  },
  {
   "id": "cost-prose",
   "applies": "prose",
   "patterns": [
    [
     "(?:US)?\\$\\s?\\d",
     ""
    ],
    [
     "\\d[\\d.,]{0,20}\\s?(?:USD|MXN)\\b",
     ""
    ],
    [
     "\\b(?:USD|MXN)\\b",
     ""
    ],
    [
     "\\b(?:balance|top-up|top up)\\b[^.\\n]{0,16}?\\d",
     "i"
    ],
    [
     "\\d[\\d.,]{0,20}[^.\\n\\d]{0,8}\\b(?:balance|top-up)\\b",
     "i"
    ]
   ],
   "codeStringPatterns": [
    [
     "(?:US)?\\$\\s?\\d+[.,]\\d",
     ""
    ],
    [
     "US\\$\\s?\\d",
     ""
    ],
    [
     "\\d[\\d.,]{0,20}\\s?(?:USD|MXN)\\b",
     ""
    ],
    [
     "\\b(?:USD|MXN)\\b",
     ""
    ]
   ]
  },
  {
   "id": "host",
   "applies": "text",
   "patterns": [
    [
     "\\bVM\\b",
     ""
    ],
    [
     "\\bmb-vm\\b",
     ""
    ],
    [
     "cloudflared",
     "i"
    ],
    [
     "Cloudflare (?:Access|tunnel)",
     "i"
    ],
    [
     "trycloudflare\\.com",
     "i"
    ],
    [
     "\\bssh (?:-\\S{1,30} (?:[^-\\s]\\S{0,60} )?){0,8}\\S{1,80}@",
     ""
    ],
    [
     "\\b10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}\\b",
     ""
    ],
    [
     "\\b172\\.(?:1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3}\\b",
     ""
    ],
    [
     "\\b192\\.168\\.\\d{1,3}\\.\\d{1,3}\\b",
     ""
    ],
    [
     "critterlab",
     "i"
    ],
    [
     "/etc/miniaturebeasts",
     ""
    ],
    [
     "/srv/miniaturebeasts",
     ""
    ]
   ]
  },
  {
   "id": "session",
   "applies": "text",
   "patterns": [
    [
     "/tmp/claude-\\d+",
     ""
    ],
    [
     "scratchpad/",
     ""
    ],
    [
     "-home-user-[\\w-]*/[0-9a-f]{8}-",
     ""
    ],
    [
     "session_[0-9A-Za-z]{20,}",
     ""
    ],
    [
     "claude\\.ai/code/session",
     ""
    ],
    [
     "\\bcodex\\b",
     "i"
    ],
    [
     "GPT-6(?:\\.\\d)?\\s?Sol",
     ""
    ],
    [
     "\\bSol High\\b",
     ""
    ]
   ]
  },
  {
   "id": "abs-path",
   "applies": "text",
   "patterns": [
    [
     "/home/user/",
     ""
    ],
    [
     "(?<![\\w.-])/root/",
     ""
    ],
    [
     "C:\\\\Users\\\\",
     "i"
    ],
    [
     "/opt/node-tools",
     ""
    ],
    [
     "/opt/pw-browsers",
     ""
    ]
   ]
  },
  {
   "id": "secret-value",
   "applies": "text",
   "patterns": [
    [
     "AIza[\\w-]{20,}",
     ""
    ],
    [
     "\\bsk-(?:proj-|svcacct-|admin-|ant-[a-z]{3,5}\\d{2}-)?[A-Za-z0-9_-]{20,}",
     ""
    ],
    [
     "\\bgh[pousr]_[A-Za-z0-9]{30,}",
     ""
    ],
    [
     "github_pat_",
     ""
    ],
    [
     "\\bxox[abposer]-[A-Za-z0-9-]{8,}",
     ""
    ],
    [
     "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b",
     ""
    ],
    [
     "-----BEGIN [A-Z ]*PRIVATE KEY-----",
     ""
    ],
    [
     "\\b[\\w-]{0,40}(?:api[_-]?key|access[_-]?key|private[_-]?key|secret|token|password|passwd)[\\w-]{0,40}[\"']?\\s{0,3}(?:=|:|=>)\\s{0,3}[\"'][^\"'\\s$<{]{6,200}[\"'](?!\\s*\\+)",
     "i"
    ],
    [
     "\\beyJ[A-Za-z0-9_-]{30,}",
     ""
    ],
    [
     "\\b[A-Z][A-Z0-9_]*(?:API_KEY|TOKEN|SECRET|PASSWORD)[A-Z0-9_]*=[^\\s\"'$#<{(]{12,}",
     ""
    ],
    [
     "\\bBearer [A-Za-z0-9._~+/-]{20,}",
     ""
    ],
    [
     "\\b[\\w-]{0,40}(?:api[_-]?key|token|secret|password)[\\w-]{0,40}\\s{0,3}:\\s{0,3}(?=[A-Za-z0-9_-]*\\d)(?=[A-Za-z0-9_-]*[A-Za-z])[A-Za-z0-9_-]{20,}\\b",
     "i"
    ]
   ]
  },
  {
   "id": "image-text",
   "applies": "image",
   "uses": [
    "session",
    "abs-path"
   ],
   "patterns": [
    [
     "Claude",
     ""
    ]
   ]
  },
  {
   "id": "process-label",
   "applies": "process-docs",
   "_note": "Process labels, dates and project words in the public docs (owner, 2026-10-09 13:49). Applies to design/**/*.md, README.md and ROADMAP.md; never docs-standard.md, fenced code blocks or inline code. Diff mode everywhere it applies; tree mode only under the paths in `tree`, which the documentation lead extends as each folder is cleaned.",
   "paths": {
    "prefixes": [
     "design/"
    ],
    "suffix": ".md",
    "files": [
     "README.md",
     "ROADMAP.md"
    ],
    "excludeBasenames": [
     "docs-standard.md"
    ]
   },
   "tree": [],
   "patterns": [
    [
     "\\*\\*(?:Decided|Working rule|Proposal|Amended|Parked|Revised|Retitled|Approved)\\b",
     ""
    ],
    [
     "\\((?:Decided|decided|Working rule|Proposal)\\)",
     ""
    ],
    [
     "\\bDecided (?:as|by|on|in|\\d)",
     ""
    ],
    [
     "\\b(?:the owner|project lead|as recommended)\\b",
     ""
    ],
    [
     "\\b(?:Proposal|Memo|Options memo)\\*{0,2},? (?:from|by)\\b",
     ""
    ],
    [
     "\\b(?:cairn|hull|outing|pocket)\\b",
     "i"
    ]
   ],
   "datePattern": [
    "\\b20\\d\\d-\\d\\d-\\d\\d\\b",
    ""
   ]
  }
 ],
 "exclude": [
  "v1/native/vendor/",
  ".github/public-guard/"
 ],
 "allowlist": [
  {
   "path": "v1/native/tests/test_selected_presenter.py",
   "value": "test-only-password",
   "rule": "secret-value",
   "reason": "a test fixture, never a real password"
  },
  {
   "path": "v1/native/tests/test_updater.py",
   "value": "TEST_ONLY_TOKEN",
   "rule": "secret-value",
   "reason": "a test fixture, never a real token"
  },
  {
   "path": "prototypes/caddy/tests/caddy.test.mjs",
   "value": "test-key-never-used",
   "rule": "secret-value",
   "reason": "a test fixture, never a real key"
  },
  {
   "path": "v1/native/tests/test_sandbox_reset.py",
   "value": "reset-test",
   "rule": "secret-value",
   "reason": "a test fixture, never a real secret"
  },
  {
   "path": "ROADMAP.md",
   "value": "US$750",
   "rule": "cost-prose",
   "reason": "the kit's retail target, public product information (owner, 2026-10-09 13:21)"
  },
  {
   "path": "design/devices.md",
   "value": "US$750",
   "rule": "cost-prose",
   "reason": "the kit's retail target, public product information (owner, 2026-10-09 13:21)"
  },
  {
   "path": "design/proposals/species-names.md",
   "value": "genus (2026-10-09)",
   "rule": "process-label",
   "reason": "the date a name clearance search was run, a record not a decision label"
  }
 ],
 "commitTrailers": [
  "Co-Authored-By:",
  "Claude-Session:",
  "Generated with"
 ]
}
