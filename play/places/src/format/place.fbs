// The baked place formats (place design A1.5). FlatBuffers, little endian, read zero-copy by the JS reader (flatbuffers npm) and by C (flatcc).
//   .mbtiles  a tile set:   root_type TileSet
//   .mbplace  a place:      root_type Place
// A tile set is formatVersion 1. A place is formatVersion 2 (baked-package-8: the bake's hold outputs, rim steps, seed and cell are in the file); a place of format 1 reads as one with none of them.
// A change to this file that is not backwards compatible raises format_version and is a deliberate chunk.
// File identifiers (written by write.mjs, checked by the readers): "MBTS" for a tile set, "MBPL" for a place.

namespace mb.places;

enum RemapName : ubyte { dark, light, dark2, fog, fade, storm, veil }
enum PairMode : ubyte { opaque, over }
enum SpriteGroup : ubyte { prop, decal, canopy }
enum PlaceType : ubyte { pond, rock, wood, meadow }
enum HeartKind : ubyte { moment, nest, spring, stone }
enum TellKind : ubyte { prints, beat, shimmer, rustle, bolt }
enum Side : ubyte { N, E, S, W }
enum ReachBy : ubyte { none, rambler, digger }

// ---- the tile set ----

table Remap {            // a light table: palette index -> palette index
  name: RemapName;
  map: [ubyte];          // 256 entries
}

table Tile {             // a tile as the layers name it; one frame is static
  frames: [uint16];      // atlas slots, one per animation frame
  frame_ms: uint16;      // all animated tiles share one clock; this is the step
}

table Pair {             // a ROW of the tile set: one piece of the terrain layers (the name is the format's; the set has no pairs any more). The device never reads the rows: it blits tile ids.
  lower: ubyte;          // terrain values (the IntGrid values of terrain.json). A fill row: lower == upper == the terrain; an over row: upper = the terrain, lower = 0
  upper: ubyte;
  mode: PairMode;        // opaque for a fill row, over for the rest
  tiles: [uint16];       // an over row: 16 tile ids by corner index NW*8 + NE*4 + SW*2 + SE, slot 0 = 0xFFFF (empty); a fill row: none; a way-up row: 6
  full_variants: [uint16];   // a fill row: tile ids of the fill variants, picked by hash; an over row: the all-upper tile, when the terrain has a ground
  empty_variants: [uint16];  // unused (empty)
}

table Sprite {           // a prop, decal or canopy piece
  kind: string;
  group: SpriteGroup;
  w48: uint16;
  h48: uint16;
  w24: uint16;
  h24: uint16;
  anchor_x48: int16;     // the foot pixel
  anchor_y48: int16;
  anchor_x24: int16;
  anchor_y24: int16;
  footprint: [byte];     // pairs of tile offsets (dx, dy) from the entity's cell that block
  frames48: [uint32];    // byte offsets of each frame's RLE data in sprite_atlas48
  frames24: [uint32];
  frame_ms: uint16;
  canopy: short = -1;    // index in sprites of the canopy piece drawn over the explorer, or -1
}

table Cycle {            // palette cycling, applied at the palette stage
  first: ubyte;
  count: ubyte;
  step_ms: uint16;
}

table Licence {          // kept in the blob so a device dump says where its art came from
  spdx: string;
  author: string;
  source: string;
  fetched: string;
}

table TileSet {
  id: string;
  format_version: uint16;
  tile: ubyte;           // 48
  half: ubyte;           // 24
  palette: [uint32];     // 0x00RRGGBB of indices 48..; 0..47 are the core palette and are not stored
  light_tables: [Remap];
  atlas48: [ubyte];      // tiles stacked vertically, 8 bits per pixel, index 0 transparent
  atlas24: [ubyte];
  tiles: [Tile];
  pairs: [Pair];
  sprites: [Sprite];
  sprite_atlas48: [ubyte];   // RLE rows (blit.mjs): records [skip, n, n pixels], each row ended by [0, 0]
  sprite_atlas24: [ubyte];
  cycles: [Cycle];
  licence: Licence;
}

// ---- the place ----

struct Point { x: short; y: short; }

table Layer {            // one ground layer, packed by depth: layer k holds the k-th piece drawn on every dual tile (a dual tile covers its own square, so only the order inside one tile matters)
  pair: ubyte (deprecated);   // was the index in the set's pairs; a layer is no longer one pair's
  tiles: [uint16];       // (w + 1) * (h + 1) tile ids, row by row; 0xFFFF draws nothing
}

table Placed {           // a prop, decal or canopy piece placed on the place
  kind: ushort;          // index in the set's sprites
  x: short;              // pixels at 48 px, the sprite's anchor point
  y: short;
  sort_y: short;
}

table Heart {
  x: short;
  y: short;
  kinds: [HeartKind];
  species: [string];
  reveal_line: string;
  reach_by: ReachBy;
}

table Clue {
  tell: TellKind;
  points: [Point];
}

table Find {
  x: short;
  y: short;
  kinds: [ubyte];        // FindKind: pod, fruit, dew, stone, material
  chance: float;
  what: string;          // format 2: the bake's own name of the find ('pearl'), empty for none
  herd: short = -1;      // format 2: the herd a pod belongs to, -1 for none
  hollow: short = -1;    // format 2: the index of the moss hollow sign the find lies in, -1 for none
  forced: bool;          // format 2
  spot: string;          // format 2: the set piece the find lies at, empty for none
}

table Landmark {
  prop: ushort;          // index in the set's sprites
  x: short;
  y: short;
  label: string;
}

table Opening {
  side: Side;
  from: ubyte;           // first cell along the edge
  to: ubyte;             // last cell
}

table Spawn {
  x: ubyte;              // the zone, in cells
  y: ubyte;
  w: ubyte;
  h: ubyte;
  species: [string];
  count: ubyte;
}

// ---- format 2: the hold outputs of the bake (the Generator's hold.mjs), rolled once at the bake from the seed, so the Companion never generates ----
// Coordinates are the baked place's tiles (its one-tile apron included), as the bake made them.

table Scree {            // a scree crossing the Tuliko walks: the side of the cell, the first line along it, the edge index
  side: Side;
  s: ubyte;
  ei: int;
}

table Piece {            // a set piece the page draws (the slab of a sleepers' bed)
  piece: string;
  x: short;
  y: short;
  w: ubyte;
  spot: string;
}

table Strike {           // a strike or meteor mark: the bake's value (a mark's age advances in the save, never here)
  x: short;
  y: short;
  age: short;
  glass: bool;
  read: bool;
}

table Bank {             // an earth bank's site (a Rupar digs it)
  x: short;
  y: short;
  w: short;
  h: short;
}

table Sign {             // a map sign: kind 'moss-hollow' (x, y, r, finds), 'reedline' (banks, pearl) or 'tracks' (species, path, to)
  kind: string;
  x: short;
  y: short;
  r: short;
  finds: [short];
  banks: [Bank];
  pearl: short;
  species: string;
  path: [Point];
  to: [short];
}

table Trace {            // an explorer's trace
  kind: string;
  x: short;
  y: short;
}

table StampCell {
  x: short;
  y: short;
  k: string;
}

table Stamp {            // a set piece's stamp: where it stands and what its cells are
  id: string;
  kind: string;
  role: string;
  x: short;
  y: short;
  w: short;
  h: short;
  tier: short = -1;      // -1: none
  entry_dist: double;
  spine_dist: double;
  see_from: [short];
  has_see_from: bool;
  cells: [StampCell];
}

table HoldLandmark {     // the cell's landmark as the hold makes it (tile coordinates); the place's own landmarks hold its prop and label
  kind: string;
  name: string;
  slot: string;
  x: short;
  y: short;
}

table Place {
  id: string;
  format_version: uint16;
  set: string;           // id of the tile set
  w: ubyte;
  h: ubyte;
  type: PlaceType;
  names: [string];
  mirror_of: string;     // the id of the place this is the mirrored variant of, empty otherwise
  terrain: [ubyte];      // w * h terrain values
  ground: [Layer];       // in draw order
  decals: [Placed];
  props: [Placed];
  canopy: [Placed];
  heart: Heart;
  clues: [Clue];
  finds: [Find];
  landmarks: [Landmark];
  openings: [Opening];
  spawns: [Spawn];
  block_mask: [ubyte];   // w * h bits, row by row, least significant bit first: terrain play class and prop footprints combined
  top: [ubyte];          // w * h terrain values: the ground under each raised (cliff) tile, 0 = grass; empty on a place that has none (a hand-set place), which then draws its raised top as it always did
  // ---- format 2 (the baked package's cell). A place of format 1 has none of these. ----
  seed: uint;            // the world's seed the cell was made for
  cell: ushort;          // the cell's index in its region (the Generator's slab and special rolls are a hash of seed and cell, never of generator state)
  rim_steps: [ubyte];    // w * h: the steps a rim line refuses (bits up 1, down 2, left 4, right 8)
  ground_at: Point;      // the tile the cell's finds lie on (hold `ground`), when has_ground_at
  has_ground_at: bool;
  soft_wade: [Point];    // the water tiles of the crossing a Tuliko wades
  soft_scree: [Scree];
  pieces: [Piece];
  shelter: [Point];
  strikes: [Strike];
  signs: [Sign];
  traces: [Trace];
  stamps: [Stamp];
  banks: [Bank];
  hold_landmark: HoldLandmark;
}

root_type Place;       // the schema has two kinds of blob; TileSet is read with getRootAsTileSet, and each blob carries its own identifier
