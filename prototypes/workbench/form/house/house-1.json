{
  "schema": "mb-house/1",
  "id": "house-1",
  "status": "chunk 1: the face, the head carriage and the head size. The bands below are the art director's first values (ad-chibi-anatomy.md section 1-3, as revised by ad-appeal-research.md), read from the masters on day 1 of chunk 1. They move with the owner's head-size pick and the art director's review: change them here, never in code.",
  "plans": {
    "A": "quadruped",
    "B": "upright biped",
    "C": "mochi, head and body one mass",
    "D": "limbless, serpentine",
    "E": "hexapod, insect"
  },
  "kinds": {
    "head": {
      "round": { "exponent": 2.0 },
      "bean": { "exponent": 2.2 },
      "soft-block": { "exponent": 2.6 },
      "pear": { "exponent": 2.2 },
      "onion": { "exponent": 2.0 }
    },
    "muzzle": { "none": {}, "button": {}, "pad": {}, "short-taper": {}, "beak": {} },
    "nose": { "mound": {}, "soft-triangle": {}, "disc": {}, "bump": {}, "none": {} },
    "mouth": { "smile": {}, "w": {}, "tiny-o": {}, "dot": {}, "beak-line": {}, "closed-line": {} },
    "eye": { "round": { "aspect": 1.0 }, "almond": { "aspect": 0.85 }, "sleepy": { "aspect": 1.0 }, "jewel": { "aspect": 1.0 } }
  },
  "bands": {
    "A": {
      "form.head":          { "measure": "H/S",              "lo": 0.45, "hi": 0.60, "map": "geo" },
      "form.head-width":    { "measure": "W/H",              "lo": 1.0,  "hi": 1.4,  "map": "lin" },
      "form.head-depth":    { "measure": "D/H",              "lo": 0.85, "hi": 1.1,  "map": "lin" },
      "form.cheek":         { "measure": "cheek",            "lo": 0.0,  "hi": 1.0,  "map": "lin" },
      "form.eye-size":      { "measure": "E/Wf",             "lo": 0.22, "hi": 0.36, "map": "geo" },
      "form.eye-height":    { "measure": "eye-drop/H",       "lo": 0.45, "hi": 0.62, "map": "lin" },
      "form.eye-spacing":   { "measure": "spacing/E",        "lo": 1.5,  "hi": 2.2,  "map": "lin" },
      "form.pupil":         { "measure": "pupil/E",          "lo": 0.5,  "hi": 0.7,  "map": "lin" },
      "form.lid":           { "measure": "lid/E",            "lo": 0.05, "hi": 0.2,  "map": "lin" },
      "form.eye-ring":      { "measure": "ring/E",           "lo": 0.0,  "hi": 0.15, "map": "lin" },
      "form.muzzle":        { "measure": "projection/H",     "lo": 0.0,  "hi": 0.35, "map": "lin" },
      "form.muzzle-width":  { "measure": "muzzle-w/W",       "lo": 0.35, "hi": 0.65, "map": "lin" },
      "form.muzzle-height": { "measure": "muzzle-h/H",       "lo": 0.25, "hi": 0.45, "map": "lin" },
      "form.nose":          { "measure": "nose-w/W",         "lo": 0.08, "hi": 0.30, "map": "geo" },
      "form.nose-drop":     { "measure": "nose-drop/E",      "lo": 0.0,  "hi": 0.6,  "map": "lin" },
      "form.mouth-width":   { "measure": "mouth-w/E",        "lo": 0.5,  "hi": 1.2,  "map": "lin" },
      "form.mouth-upturn":  { "measure": "upturn",           "lo": 0.05, "hi": 0.30, "map": "lin" },
      "form.mouth-gap":     { "measure": "mouth-gap/H",      "lo": 0.0,  "hi": 0.08, "map": "lin" },
      "form.carriage":      { "measure": "chin-up-deg",      "lo": 0.0,  "hi": 15.0, "map": "lin" },
      "form.torso":         { "measure": "torso/H",          "lo": 1.0,  "hi": 1.8,  "map": "lin", "provisional": "body genes are chunk 2; chunk 1 fixes them at the type specimen" },
      "form.chest":         { "measure": "chest/W",          "lo": 0.8,  "hi": 1.1,  "map": "lin", "provisional": "chunk 2" },
      "form.rump":          { "measure": "P/C",              "lo": 0.7,  "hi": 1.0,  "map": "lin", "provisional": "chunk 2" },
      "form.leg-length":    { "measure": "leg/H",            "lo": 0.25, "hi": 0.6,  "map": "lin", "provisional": "chunk 2" },
      "form.leg-girth":     { "measure": "leg-thick/H",      "lo": 0.28, "hi": 0.45, "map": "lin", "provisional": "chunk 2" },
      "form.paw":           { "measure": "paw/leg",          "lo": 1.25, "hi": 1.7,  "map": "lin", "provisional": "chunk 2" },
      "form.toe-size":      { "measure": "toe/paw",          "lo": 0.25, "hi": 0.4,  "map": "lin", "provisional": "chunk 2" },
      "form.crest":         { "measure": "crest-len/H",      "lo": 0.3,  "hi": 0.8,  "map": "lin", "provisional": "chunk 3 (the leaf fan)" }
    },
    "B": { "extends": "A", "override": {
      "form.head": { "measure": "H/S", "lo": 0.35, "hi": 0.50, "map": "geo" }
    } },
    "C": { "extends": "A", "override": {
      "form.head":          null,
      "form.head-width":    null,
      "form.head-depth":    null,
      "form.cheek":         null,
      "form.eye-size":      { "measure": "E/Wf", "lo": 0.18, "hi": 0.32, "map": "geo", "also": "E >= 0.06 of the mass width" },
      "form.eye-height":    null,
      "form.muzzle":        null,
      "form.muzzle-width":  null,
      "form.muzzle-height": null,
      "form.carriage":      null
    } },
    "D": { "extends": "A", "override": {
      "form.head":          { "measure": "H/T", "lo": 1.1, "hi": 1.6, "map": "geo", "also": "T is the thickest body section" },
      "form.muzzle":        { "measure": "projection/H", "lo": 0.0, "hi": 0.1, "map": "lin", "also": "a bump nose and a smile: the limbless plan has no muzzle" },
      "form.muzzle-width":  null,
      "form.muzzle-height": null,
      "form.torso":         null,
      "form.chest":         null,
      "form.rump":          null,
      "form.leg-length":    null,
      "form.leg-girth":     null,
      "form.paw":           null,
      "form.toe-size":      null,
      "form.crest":         null,
      "form.body-length":   { "measure": "body/H",       "lo": 1.2,  "hi": 2.2,  "map": "lin", "provisional": "chunk 1 snail" },
      "form.body-thick":    { "measure": "T/H",          "lo": 0.5,  "hi": 0.9,  "map": "lin", "provisional": "chunk 1 snail" },
      "form.rise":          { "measure": "rise/H",       "lo": 0.1,  "hi": 0.45, "map": "lin", "provisional": "chunk 1 snail: how far K stands above the floor on its rise" },
      "form.skirt":         { "measure": "skirt/T",      "lo": 1.1,  "hi": 1.5,  "map": "lin", "provisional": "chunk 1 snail" },
      "form.antenna":       { "measure": "antenna/H",    "lo": 0.5,  "hi": 1.2,  "map": "lin" }
    } },
    "E": { "extends": "A", "override": {
      "form.head": { "measure": "H/S", "lo": 0.50, "hi": 0.70, "map": "geo" },
      "form.muzzle": null, "form.muzzle-width": null, "form.muzzle-height": null
    } }
  },
  "rules": [
    { "id": "R1-face", "measure": "eye-share", "plans": { "A": [0.16, 0.24], "E": [0.16, 0.24], "B": [0.10, 0.16], "D": [0.10, 0.16], "C": [0.07, 0.12] },
      "enforce": ["clamp:eye-share", "check"], "on": true, "why": "a big face is the main cuteness signal; measured on the core silhouette (no headgear, tail or wings)" },
    { "id": "R1-head", "measure": "H/S", "plans": { "A": [0.45, 0.60], "B": [0.35, 0.50], "E": [0.50, 0.70] },
      "enforce": ["construction"], "on": true, "why": "the face-bearing mass dominates where the head is its own mass" },
    { "id": "R1-head-D", "measure": "H/T", "plans": { "D": [1.1, null] },
      "enforce": ["construction"], "on": true, "why": "the head stands up and the body lies down" },
    { "id": "R3-size", "measure": "E/Wf", "plans": { "A": [0.22, 0.36], "B": [0.22, 0.36], "D": [0.22, 0.36], "E": [0.22, 0.36], "C": [0.18, 0.32] },
      "enforce": ["band"], "on": true, "why": "big eyes are the face; too small hurts more than too big helps" },
    { "id": "R3-height", "measure": "eye-drop/H", "plans": { "A": [0.45, 0.62], "B": [0.45, 0.62], "D": [0.45, 0.62], "E": [0.45, 0.62] },
      "enforce": ["band"], "on": true, "why": "low eyes leave a big forehead; high eyes on the corners read as a frog" },
    { "id": "R3-spacing", "measure": "spacing/E", "plans": { "A": [1.5, 2.2], "B": [1.5, 2.2], "D": [1.5, 2.2], "E": [1.5, 2.2], "C": [1.5, 2.2] },
      "enforce": ["clamp:eye-fit", "band"], "on": true, "why": "too wide reads as a fish, too close as mean" },
    { "id": "R4-stack", "measure": "eye-to-mouth/H", "plans": { "A": [0, 0.35], "B": [0, 0.35], "D": [0, 0.35], "E": [0, 0.35] },
      "enforce": ["clamp:face-stack"], "on": true, "why": "low, close-together features are the infant face" },
    { "id": "R4-nose-drop", "measure": "nose-drop/E", "plans": { "A": [0, 0.6], "B": [0, 0.6], "D": [0, 0.6], "E": [0, 0.6] },
      "enforce": ["band"], "on": true, "why": "the nose sits between the eye line and 0.6 E below it" },
    { "id": "R4-nose-width", "measure": "nose-w/E", "plans": { "A": [0, 0.6], "B": [0, 0.6], "D": [0, 0.6], "E": [0, 0.6] },
      "enforce": ["clamp:nose-fit"], "on": true, "why": "a small nose (the AD's number; the signed Loika master falls outside it, see the calibration table)" },
    { "id": "R4-mouth-gap", "measure": "mouth-gap/H", "plans": { "A": [0, 0.08], "B": [0, 0.08], "D": [0, 0.08], "E": [0, 0.08] },
      "enforce": ["band"], "on": true, "why": "the mouth starts at the nose base" },
    { "id": "R4-forehead", "measure": "forehead/H", "plans": { "A": [0.25, null], "B": [0.25, null], "D": [0.25, null], "E": [0.25, null] },
      "enforce": ["band"], "on": true, "why": "crown to eye top: the dome above the face" },
    { "id": "R5-pitch", "measure": "chin-up-deg", "plans": { "A": [0, 15], "B": [0, 15], "D": [0, 15], "E": [0, 15] },
      "enforce": ["solver"], "on": true, "why": "the head is up, never down past level" },
    { "id": "R5-back", "measure": "back-gap/H", "plans": { "A": [0.1, null] },
      "enforce": ["solver"], "on": true, "why": "the crown is the top of the body; the back top is at least 0.1 H below it" },
    { "id": "R6-body-yaw", "measure": "yaw-body", "plans": { "A": [30, 65], "B": [30, 65], "C": [30, 65], "D": [55, 85], "E": [55, 85] },
      "enforce": ["solver"], "on": true, "why": "per plan: long bodies stand nearly in profile with only the face turned to us (technical plan 6.1)" },
    { "id": "R6-face-yaw", "measure": "yaw-face", "plans": { "A": [15, 40], "B": [15, 40], "C": [15, 40], "D": [15, 40], "E": [15, 40] },
      "enforce": ["solver"], "on": true, "why": "the creature notices you" },
    { "id": "R6-head-yaw", "measure": "yaw-head", "plans": { "A": [15, 50], "B": [15, 50], "C": [15, 50], "D": [15, 50], "E": [15, 50] },
      "enforce": ["solver"], "on": true, "why": "the head is turned on the body" },
    { "id": "R6-roll", "measure": "roll", "plans": { "A": [3, 15], "B": [3, 15], "C": [3, 15], "D": [3, 15], "E": [3, 15] },
      "enforce": ["solver"], "on": true, "why": "a tilt raised cuteness without raising eeriness; every master tilts" },
    { "id": "R7-gaze", "measure": "gaze-offset/E", "plans": { "A": [0, 0.15], "B": [0, 0.15], "C": [0, 0.15], "D": [0, 0.15], "E": [0, 0.15] },
      "enforce": ["built-in"], "on": true, "why": "both pupils aim at the camera" },
    { "id": "R7-catch", "measure": "catch-disagree-px", "plans": { "A": [0, 0.5], "B": [0, 0.5], "C": [0, 0.5], "D": [0, 0.5], "E": [0, 0.5] },
      "enforce": ["built-in", "check"], "on": true, "why": "the catch lights share one screen offset" },
    { "id": "R11-eye-size", "measure": "eye-size-diff", "plans": { "A": [0, 0.03], "B": [0, 0.03], "C": [0, 0.03], "D": [0, 0.03], "E": [0, 0.03] },
      "enforce": ["built-in"], "on": true, "why": "asymmetric pose, symmetric face" },
    { "id": "R15-iris-48", "measure": "iris-px-48", "plans": { "A": [5, null], "B": [5, null], "D": [5, null], "E": [5, null], "C": [3, null] },
      "enforce": ["glyph"], "on": true, "why": "readable at 48" },
    { "id": "R15-pupil-48", "measure": "pupil-px-48", "plans": { "A": [3, null], "B": [3, null], "D": [3, null], "E": [3, null], "C": [2, null] },
      "enforce": ["glyph"], "on": true, "why": "readable at 48" },
    { "id": "R15-iris-96", "measure": "iris-px-96", "plans": { "A": [10, null], "B": [10, null], "D": [10, null], "E": [10, null], "C": [6, null] },
      "enforce": ["glyph"], "on": true, "why": "readable at 96" },
    { "id": "R15-nose-96", "measure": "nose-px-96", "plans": { "A": [4, null], "B": [4, null], "D": [2, null], "E": [2, null] },
      "enforce": ["glyph"], "on": true, "why": "the nose is never dropped at 96 (a bump nose on a round face may be small)" },
    { "id": "R15-mouth-96", "measure": "mouth-px-96", "plans": { "A": [5, null], "B": [5, null], "D": [5, null], "E": [5, null] },
      "enforce": ["glyph"], "on": true, "why": "the mouth is never dropped at 96" },
    { "id": "R18-cues", "measure": "sick-cues", "plans": { "A": [0, 1], "B": [0, 1], "C": [0, 1], "D": [0, 1], "E": [0, 1] },
      "enforce": ["clamp:carriage-lid", "check"], "on": true, "why": "at most one soft sickness cue at a time" },
    { "id": "R13-face-contrast", "measure": "face-contrast-ratio", "plans": { "A": [1.0, null], "B": [1.0, null], "C": [1.0, null], "D": [1.0, null], "E": [1.0, null] },
      "enforce": ["check"], "on": true, "why": "the face region's value range at least the body's" },
    { "id": "R-push", "measure": "features-pushed", "plans": { "A": [0, 2], "B": [0, 2], "C": [0, 2], "D": [0, 2], "E": [0, 2] },
      "enforce": ["check"], "on": true, "why": "owner O1: at most two features in the top 15 % of their band at once; one pushed feature is charm, several are a costume" },
    { "id": "R-mouth", "measure": "mouth-w/E", "plans": { "A": [0.1, null], "B": [0.1, null], "C": [0.1, null], "D": [0.1, null], "E": [0.1, null] },
      "enforce": ["band"], "on": true, "why": "owner O6: every mibi has a mouth, at least a dot" },
    { "id": "R14-shade-ratio", "measure": "shade-ratio", "plans": { "A": [0.55, 0.70], "B": [0.55, 0.70], "C": [0.55, 0.70], "D": [0.55, 0.70], "E": [0.55, 0.70] },
      "enforce": ["renderer", "check"], "on": true, "why": "one light for the family" }
  ],
  "deferred": [
    { "id": "R2", "chunk": 2, "why": "needs the neck measure along the spine (the body)" },
    { "id": "R8", "chunk": 2, "why": "the stance and weight solver" },
    { "id": "R9", "chunk": 2, "why": "P to C and the stance" },
    { "id": "R10", "chunk": 3, "why": "outline curvature and the swell test need the final surface" },
    { "id": "R12", "chunk": 4, "why": "palette pools are checked at frame build" },
    { "id": "R17", "chunk": 3, "why": "headgear clamp: Loika's leaf fan is far from the eyes; the part budget comes with the fan" },
    { "id": "R19", "chunk": 1, "why": "carried by the band form.mouth-upturn lo = 0.05; the closed-line kind is not opened yet" },
    { "id": "R20", "chunk": 1, "why": "the kind-list test: no sclera, slit pupil or teeth kind exists" }
  ],
  "clamps": [
    { "id": "eye-fit", "order": 1, "on": true, "params": { "spacing-share-of-width": 0.9 },
      "why": "eye spacing x E must fit within 0.9 W" },
    { "id": "nose-fit", "order": 2.5, "on": true, "params": { "max-nose-over-E": 0.6 },
      "why": "R4: nose width at most 0.6 E (the signed Loika master is wider; the table says so)" },
    { "id": "face-stack", "order": 2, "on": true, "params": { "max-eye-to-mouth-H": 0.35, "soft-width": 0.08 },
      "why": "the face's vertical stack must fit R4: the muzzle height and the mouth gap compress" },
    { "id": "carriage-lid", "order": 5, "on": true, "params": { "lid-over-E": 0.2, "min-carriage-deg": 5 },
      "why": "a heavy lid forces carriage of at least 5 degrees" },
    { "id": "eye-share", "order": 6, "on": true, "params": { "soft-width": 0.15, "gain": 0.8 },
      "why": "if the eye share falls under its plan band, E grows within its own band first, then the head within its band" }
  ],
  "owner": [
    { "id": "O1", "ruling": "each mibi pushes at most one or two features", "applied": "rule R-push (the part budget, extended to every feature): at most two features in the top 15 % of their band at once. Measured and reported in chunk 1; the clamp that pulls the rest toward mid-band comes with the litter checks (chunk 4)." },
    { "id": "O3", "ruling": "needs are shown as asking, never giving up; the face always stays friendly", "applied": "R18 and R19 stay on: at most one soft sickness cue, mouth upturn at least 0.05. Needs themselves are an animation-layer matter (later)." },
    { "id": "O5", "ruling": "bigger eyes for juveniles are tried on a juvenile litter later; the band does not change now", "applied": "form.eye-size keeps 0.22 to 0.36 Wf. Nothing in chunk 1 reads a juvenile band." },
    { "id": "O6", "ruling": "every mibi has a mouth, which can be a tiny dot; there is no mouthless face kind", "applied": "kinds.mouth has no 'none' and no mouthless kind; rule R-mouth requires a mouth of at least a dot (mouth-w/E at least 0.1); tested." }
  ],
  "softclamp": { "width-share": 0.15 },
  "solver": {
    "camera": { "pitch-deg": 8 },
    "seed-keys": ["body-yaw", "face-yaw", "roll"]
  },
  "rig": {
    "face": {
      "nose-aspect": 0.62,
      "nose-relief": 0.7,
      "nose-soften": 0.035,
      "socket-depth": 0.03,
      "socket-margin": 0.16,
      "socket-soften": 0.03,
      "muzzle-union": 0.15,
      "muzzle-centre-drop": 0.02,
      "mouth-tube": 0.016,
      "mouth-soften": 0.012,
      "cheek-widen": 0.25,
      "gaze-offset-max": 0.15,
      "gaze-full-at-deg": 40,
      "catch-radius": 0.17,
      "catch-offset": [-0.2, -0.5],
      "iris-top-dark": 0.45,
      "crescent": 0.35
    },
    "ink": { "pupil-min-px": { "96": 2.0, "48": 1.6 }, "catch-min-px": { "96": 1.0, "48": 0.9 }, "mouth-min-px": { "96": 1.1, "48": 0.0 }, "nose-min-px": { "96": 2.0, "48": 0.0 } }
  },
  "light": {
    "key": { "azimuth-deg": -38, "elevation-deg": 48, "toward-camera": 0.35, "color": [1.0, 0.95, 0.86] },
    "shade": { "ratio": 0.62, "tint": [0.80, 0.82, 1.0] },
    "terminator": { "width": 0.16, "tint": [1.0, 0.72, 0.52], "strength": 0.22 },
    "occlusion": { "radii-H": [0.05, 0.12, 0.25, 0.4], "strength": 0.55 },
    "rim": { "strength": 0.16, "tint": [0.86, 0.9, 1.0], "power": 3.0 },
    "vinyl": { "strength": 0.05, "roughness": 0.5 },
    "floor": { "color": [30, 26, 34], "alpha": 110, "contact-alpha": 150 }
  }
}
