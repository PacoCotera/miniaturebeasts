{
 "$comment": "The props of the Library spread (lvgl-switch.md §2.1, §4 L; library.json spread): what views/library-props.mjs gives the face, beside the frame's. Props name what, never where: ids, statuses, strings, clan ids, flags, picture ids and the focus targets by id; no rectangle, no colour (the words place and colour everything from library.json). The fixed pictures (the gilt corner, the seal, the progress seeds) and the clan colours are the spec's, read by the face.",
 "$defs": {
  "item": {
   "type": "object",
   "required": [
    "id",
    "status",
    "name",
    "clan",
    "portrayed",
    "complete",
    "progress",
    "picture",
    "roundel"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^S[0-9]{2}$"
    },
    "status": {
     "enum": [
      "found",
      "met",
      "unmet"
     ]
    },
    "name": {
     "type": [
      "string",
      "null"
     ]
    },
    "clan": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^C[0-9]{2}$"
    },
    "portrayed": {
     "type": "boolean"
    },
    "complete": {
     "type": "boolean"
    },
    "progress": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1,
     "maximum": 4
    },
    "picture": {
     "type": [
      "string",
      "null"
     ]
    },
    "roundel": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "target": {
   "type": "object",
   "required": [
    "id",
    "group",
    "enabled"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^frame\\.S[0-9]{2}$"
    },
    "group": {
     "const": "frame"
    },
    "enabled": {
     "const": true
    }
   }
  }
 },
 "type": "object",
 "required": [
  "state",
  "regions",
  "focus"
 ],
 "additionalProperties": false,
 "properties": {
  "state": {
   "const": "spread"
  },
  "regions": {
   "type": "object",
   "required": [
    "stage",
    "leftPage",
    "rightPage"
   ],
   "additionalProperties": false,
   "properties": {
    "stage": {
     "type": "object",
     "required": [
      "picture"
     ],
     "additionalProperties": false,
     "properties": {
      "picture": {
       "type": "string"
      }
     }
    },
    "leftPage": {
     "type": "object",
     "required": [
      "items"
     ],
     "additionalProperties": false,
     "properties": {
      "items": {
       "type": "array",
       "minItems": 8,
       "maxItems": 8,
       "items": {
        "$ref": "item"
       }
      }
     }
    },
    "rightPage": {
     "type": "object",
     "required": [
      "items"
     ],
     "additionalProperties": false,
     "properties": {
      "items": {
       "type": "array",
       "minItems": 8,
       "maxItems": 8,
       "items": {
        "$ref": "item"
       }
      }
     }
    }
   }
  },
  "focus": {
   "type": "object",
   "required": [
    "cur",
    "targets"
   ],
   "additionalProperties": false,
   "properties": {
    "cur": {
     "type": "string",
     "pattern": "^frame\\.S[0-9]{2}$"
    },
    "targets": {
     "type": "array",
     "minItems": 16,
     "maxItems": 16,
     "items": {
      "$ref": "target"
     }
    }
   }
  }
 }
}
