{
 "$comment": "The props of the decision panel overlay (panel.json; frame.json regions.panel; lvgl-switch.md §2.2): `overlay` on the opening screen's message while the panel is open. Props name what, never where: the title, the cards with their asset ids and picture sizes, the cost as the bottom line's price string, flags, and the focus targets by id. The rectangles are frame.json's. The bottom line is props.frame.line, built by the host from the focused card.",
 "$defs": {
  "card": {
   "type": "object",
   "required": [
    "id",
    "picture",
    "pictureSize",
    "mark",
    "name",
    "cost",
    "gain",
    "short",
    "line",
    "loss",
    "dim",
    "art"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string"
    },
    "picture": {
     "type": "string"
    },
    "pictureSize": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "mark": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "cost": {
     "type": "string"
    },
    "gain": {
     "type": "boolean"
    },
    "short": {
     "type": "string"
    },
    "line": {
     "type": "string"
    },
    "loss": {
     "type": "boolean"
    },
    "dim": {
     "type": "boolean"
    },
    "art": {
     "type": "object",
     "required": [
      "well",
      "focused",
      "stage",
      "glow",
      "light"
     ],
     "additionalProperties": false,
     "properties": {
      "well": {
       "type": "string"
      },
      "focused": {
       "type": "string"
      },
      "stage": {
       "type": "string"
      },
      "glow": {
       "type": "string"
      },
      "light": {
       "type": "string"
      },
      "scene": {
       "type": "string"
      }
     }
    },
    "outcome": {
     "type": "string",
     "enum": [
      "wild"
     ],
     "description": "the Return outcome: its place's scene stands in the glow's place and the subject stands right of centre"
    }
   }
  },
  "target": {
   "type": "object",
   "required": [
    "id",
    "enabled"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string"
    },
    "enabled": {
     "type": "boolean"
    }
   }
  }
 },
 "type": "object",
 "required": [
  "id",
  "state",
  "regions",
  "focus"
 ],
 "additionalProperties": false,
 "properties": {
  "id": {
   "enum": [
    "panel"
   ]
  },
  "state": {
   "enum": [
    "open"
   ]
  },
  "regions": {
   "type": "object",
   "required": [
    "title",
    "cards",
    "art"
   ],
   "additionalProperties": false,
   "properties": {
    "title": {
     "type": "string"
    },
    "cards": {
     "type": "array",
     "minItems": 1,
     "maxItems": 3,
     "items": {
      "$ref": "card"
     }
    },
    "art": {
     "type": "object",
     "required": [
      "housing",
      "veil",
      "shadow",
      "chip"
     ],
     "additionalProperties": false,
     "properties": {
      "housing": {
       "type": "string"
      },
      "veil": {
       "type": "string"
      },
      "shadow": {
       "type": "string"
      },
      "chip": {
       "type": "string"
      }
     }
    }
   }
  },
  "focus": {
   "type": "object",
   "required": [
    "cur",
    "targets"
   ],
   "additionalProperties": false,
   "properties": {
    "cur": {
     "type": "string"
    },
    "targets": {
     "type": "array",
     "items": {
      "$ref": "target"
     }
    }
   }
  },
  "form": {
   "enum": [
    "strip"
   ],
   "description": "the strip form (the dock arrival's choice): no title, no veil, drawn under what it is about"
  }
 }
}
