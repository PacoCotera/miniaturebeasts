{
 "$comment": "The props of Home (lvgl-switch.md §2.1): what views/home-props.mjs gives the face, beside the frame's. Props name what, never where: strings, states, counts, asset ids, seeds, flags and the focus targets by id; no rectangle, no measure, no layout rule, no colour (the words read those from home.json and the palette). An asset id names a picture the host has made ready (the view's `requests` list them); a picture the face does not hold draws nothing. Checked by prototypes/station/tests/home-props.test.mjs (a JSON-Schema subset: type, properties, required, additionalProperties, items, enum, oneOf).",
 "$defs": {
  "lamp": { "enum": ["off", "well", "waiting", "needsYou"] },
  "person": { "type": "object", "required": ["id", "name", "stage", "picture", "waiting", "seed"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "stage": { "enum": ["juvenile", "adult", "elder"] }, "picture": { "type": "string" }, "stand": { "type": "string" }, "waiting": { "type": "boolean" }, "seed": { "type": "integer" }, "figure": { "type": "array", "items": { "type": "integer" }, "minItems": 4, "maxItems": 4, "description": "T-20261018-235 build-spec §0: [dx, dy, W, H], the drawn bbox of the figure (ink alpha >= 128, its contact shadow left out) in its picture; the ring, the tag, the walk and the keep-out are measured from it. Absent: the picture is the figure" }, "moving": { "oneOf": [{ "enum": [""] }, { "type": "object", "required": ["set", "walk", "shadow"], "additionalProperties": false, "properties": { "set": { "type": "string" }, "walk": { "type": "string" }, "shadow": { "type": "string" } } }, { "type": "object", "required": ["set", "nap"], "additionalProperties": false, "properties": { "set": { "type": "string" }, "nap": { "type": "string" } } }], "description": "Station M1 §2.2: \"\" (a still, main's walk) or the atlases of its moving set (the walk and its shadow; a bed sleeper its nap); the face never makes an id" }, "rest": { "enum": ["awake", "asleep"], "description": "Station M1 §2.6: by restOf (the rest stagger) from the Station time" } } },
  "well": { "type": "object", "required": ["pod", "glint"], "additionalProperties": false, "properties": { "pod": { "type": "string" }, "glint": { "type": "string" } } },
  "target": { "type": "object", "required": ["id", "group"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "group": { "enum": ["vivarium", "resident", "column"] }, "enabled": { "type": "boolean" } } }
 },
 "type": "object", "required": ["state", "regions", "focus"], "additionalProperties": false,
 "properties": {
  "state": { "enum": ["home"] },
  "regions": { "type": "object", "required": ["glass", "residents", "bed", "cargo", "pods", "incubator", "probe", "library"], "additionalProperties": false, "properties": { 
   "glass": { "type": "object", "required": ["picture"], "additionalProperties": false, "properties": { "picture": { "type": "string" } } },
   "residents": { "type": "array", "items": { "$ref": "person" } },
   "bed": { "type": "object", "required": ["state", "picture", "mark", "sleepers"], "additionalProperties": false, "properties": { "state": { "enum": ["docked", "away", "none"] }, "picture": { "type": "string" }, "mark": { "type": "string" }, "sleepers": { "type": "array", "items": { "$ref": "person" } }, "sendoff": { "type": "boolean" } } },
   "cargo": { "type": "object", "required": ["plate", "state", "crates", "lamp", "bay", "crate", "waiting"], "additionalProperties": false, "properties": { "plate": { "type": "string" }, "state": { "enum": ["away", "empty", "crates", "waiting"] }, "crates": { "type": "integer" }, "lamp": { "$ref": "lamp" }, "bay": { "type": "string" }, "crate": { "type": "string" }, "waiting": { "type": "string" } } },
   "pods": { "type": "object", "required": ["plate", "lamp", "well", "wells"], "additionalProperties": false, "properties": { "plate": { "type": "string" }, "lamp": { "$ref": "lamp" }, "well": { "type": "string" }, "wells": { "type": "array", "items": { "$ref": "well" } } } },
   "incubator": { "type": "object", "required": ["plate", "state", "lamp", "capsule"], "additionalProperties": false, "properties": { "plate": { "type": "string" }, "state": { "enum": ["empty", "growing", "ready", "painting"] }, "lamp": { "$ref": "lamp" }, "capsule": { "type": "object", "required": ["interior", "shell", "door", "bar", "glass"], "additionalProperties": false, "properties": { "interior": { "type": "string" }, "shell": { "type": "string" }, "door": { "type": "string" }, "bar": { "type": "string" }, "glass": { "type": "string" }, "pod": { "type": "string" }, "podSize": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 }, "podAnchor": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 } } } } },
   "probe": { "type": "object", "required": ["plate", "state", "lamp", "cradle", "shields", "frame"], "additionalProperties": false, "properties": { "plate": { "type": "string" }, "state": { "enum": ["docked", "away"] }, "lamp": { "$ref": "lamp" }, "cradle": { "type": "string" }, "shields": { "type": "object", "required": ["count", "whole", "wholePicture", "gonePicture"], "additionalProperties": false, "properties": { "count": { "type": "integer" }, "whole": { "type": "integer" }, "wholePicture": { "type": "string" }, "gonePicture": { "type": "string" } } }, "frame": { "type": "string" } } },
   "library": { "type": "object", "required": ["plate", "state", "lamp", "journal"], "additionalProperties": false, "properties": { "plate": { "type": "string" }, "state": { "enum": ["pages", "empty"] }, "lamp": { "$ref": "lamp" }, "journal": { "type": "string" } } } } },
  "focus": { "type": "object", "required": ["cur", "targets"], "additionalProperties": false, "properties": { "cur": { "type": "string" }, "targets": { "type": "array", "items": { "$ref": "target" } } } }
 }
}
