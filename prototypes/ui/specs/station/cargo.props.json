{
 "$comment": "The props of Cargo (lvgl-switch.md §2.1): what views/cargo-props.mjs gives the face, beside the frame's. Props name what, never where: states, counts, strings, asset ids, which crate and which place of it a pod came from, and (with reduced motion) the step the host has staged; no rectangle, no measure, no layout rule, no colour (the words read those from cargo.json and the palette). An asset id names a picture the host has made ready (the view's `requests` list them); a picture the face does not hold draws nothing. Checked by prototypes/station/tests/cargo-props.test.mjs (a JSON-Schema subset: type, properties, required, additionalProperties, items, enum).",
 "$defs": {
  "well": { "type": "object", "required": ["pod", "from"], "additionalProperties": false, "properties": { "pod": { "type": "string" }, "from": { "type": ["object", "null"], "required": ["crate", "order"], "additionalProperties": false, "properties": { "crate": { "type": "integer" }, "order": { "type": "integer" } } } } },
  "crate": { "type": "object", "required": ["ribbon", "sealed", "opening", "open", "shadow", "storeShadow", "pods", "stores"], "additionalProperties": false, "properties": { "ribbon": { "type": "string" }, "shadow": { "type": "string" }, "storeShadow": { "type": "string" }, "sealed": { "type": "string" }, "opening": { "type": "string" }, "open": { "type": "string" }, "stores": { "type": "array", "maxItems": 3, "items": { "type": "string" } }, "pods": { "type": "array", "items": { "type": "object", "required": ["picture", "well"], "additionalProperties": false, "properties": { "picture": { "type": "string" }, "well": { "type": "integer" } } } } } },
  "row": { "type": "object", "required": ["pods", "more", "reach"], "additionalProperties": false, "properties": { "pods": { "type": "integer" }, "more": { "type": "string" }, "reach": { "type": "integer" } } }
 },
 "type": "object", "required": ["state", "regions", "focus"], "additionalProperties": false,
 "properties": {
  "state": { "enum": ["bay", "opening", "report", "arrival"] },
  "regions": { "type": "object", "required": ["rack"], "additionalProperties": false, "properties": {
   "rack": { "type": "object", "required": ["insert", "wells"], "additionalProperties": false, "properties": { "insert": { "type": "string" }, "wells": { "type": "array", "items": { "$ref": "well" } } } },
   "arrival": { "type": "object", "required": ["phase", "at", "ribbon", "apron", "light", "glint", "glints", "mibis", "plates", "leaving"], "additionalProperties": false, "properties": { "phase": { "enum": ["show", "choice"] }, "at": { "type": "integer" }, "ribbon": { "type": "string" }, "apron": { "type": "string" }, "light": { "type": "string" }, "glint": { "type": "string" }, "glints": { "type": "array", "items": { "type": "boolean" } }, "mibis": { "type": "array", "maxItems": 3, "items": { "type": "string" } }, "plates": { "type": "object", "required": ["icon", "max", "whole", "mended", "words"], "additionalProperties": false, "properties": { "icon": { "type": "string" }, "max": { "type": "integer" }, "whole": { "type": "integer" }, "mended": { "type": "integer" }, "words": { "type": "string" } } }, "leaving": { "type": "object", "required": ["mark", "faces"], "additionalProperties": false, "properties": { "mark": { "type": "string" }, "faces": { "type": "array", "maxItems": 3, "items": { "type": "string" } } } } } },
   "bay": { "type": "object", "required": ["state", "open", "door"], "additionalProperties": false, "properties": { "state": { "enum": ["open", "shut"] }, "open": { "type": "string" }, "door": { "type": "string" } } },
   "crates": { "type": "object", "required": ["places", "shadow"], "additionalProperties": false, "properties": { "places": { "type": "array", "items": { "type": "string" } }, "shadow": { "type": "string" } } },
   "waitingPods": { "type": "object", "required": ["pods", "shadow"], "additionalProperties": false, "properties": { "pods": { "type": "array", "items": { "type": "string" } }, "shadow": { "type": "string" } } },
   "opening": { "type": "object", "required": ["crate", "at", "crates"], "additionalProperties": false, "properties": { "crate": { "type": "integer" }, "at": { "type": "integer" }, "crates": { "type": "array", "items": { "$ref": "crate" } } } },
   "report": { "type": "object", "required": ["plate", "crate", "map", "podIcon", "emptyPod", "shieldIcon", "probeIcon", "arrow", "crates", "gathered", "probe"], "additionalProperties": false, "properties": {
     "plate": { "type": "string" }, "crate": { "type": "string" }, "map": { "type": "string" }, "podIcon": { "type": "string" }, "emptyPod": { "type": "string" }, "shieldIcon": { "type": "string" }, "probeIcon": { "type": "string" }, "arrow": { "type": "string" },
     "crates": { "type": "array", "items": { "$ref": "row" } },
     "gathered": { "type": "object", "required": ["e", "d", "s"], "additionalProperties": false, "properties": { "e": { "type": "string" }, "d": { "type": "string" }, "s": { "type": "string" } } },
     "probe": { "type": ["object", "null"], "required": ["plates", "spent"], "additionalProperties": false, "properties": { "plates": { "type": "integer" }, "spent": { "type": "string" } } },
     "goal": { "type": ["object", "null"], "required": ["text", "icons", "plain"], "additionalProperties": false, "properties": { "text": { "type": "string" }, "icons": { "type": "string" }, "plain": { "type": "string" } } },
     "meanwhile": { "type": ["object", "null"], "required": ["emblem", "glint", "price"], "additionalProperties": false, "properties": { "emblem": { "type": "string" }, "glint": { "type": "string" }, "price": { "type": "string" } } } } }
  } },
  "focus": { "type": "object", "required": ["cur", "targets"], "additionalProperties": false, "properties": { "cur": { "enum": ["room"] }, "targets": { "type": "array" } } }
 }
}
