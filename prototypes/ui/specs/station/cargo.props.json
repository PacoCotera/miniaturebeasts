{
 "$comment": "The props of Cargo (lvgl-switch.md §2.1): what views/cargo-props.mjs gives the face, beside the frame's. Props name what, never where: states, counts, strings, asset ids, which crate and which place of it a pod came from and where it goes, and (with reduced motion) the step the host has staged; no rectangle, no measure, no layout rule, no colour (the words read those from cargo.json and the palette). An asset id names a picture the host has made ready (the view's `requests` list them); a picture the face does not hold draws nothing. Pictures are never in props, only their ids. Checked by prototypes/station/tests/cargo-props.test.mjs (a JSON-Schema subset: type, properties, required, additionalProperties, items, enum).",
 "$defs": {
  "from": { "type": ["object", "null"], "required": ["crate", "order"], "additionalProperties": false, "properties": { "crate": { "type": "integer" }, "order": { "type": "integer" } } },
  "well": { "type": "object", "required": ["pod", "from"], "additionalProperties": false, "properties": { "pod": { "type": "string" }, "from": { "$ref": "from" } } },
  "berth": { "type": "object", "required": ["crate", "shadow", "lifting", "done", "k", "kind"], "additionalProperties": false, "properties": { "crate": { "type": "string" }, "shadow": { "type": "string" }, "lifting": { "type": "string" }, "done": { "type": "string" }, "k": { "type": "integer" }, "kind": { "enum": ["walk", "sitting"] } } },
  "find": { "type": "object", "required": ["kind", "big", "small", "slot"], "additionalProperties": false, "properties": { "kind": { "enum": ["crystal", "pearl", "shard"] }, "big": { "type": "string" }, "small": { "type": "string" }, "slot": { "type": "integer" } } },
  "crate": { "type": "object", "required": ["kind", "berth", "mats", "pods", "finds", "portrait"], "additionalProperties": false, "properties": {
   "kind": { "enum": ["walk", "sitting"] }, "berth": { "type": "integer" },
   "mats": { "type": "array", "maxItems": 3, "items": { "type": "object", "required": ["name", "amount", "big", "small"], "additionalProperties": false, "properties": { "name": { "enum": ["energy", "data", "essence"] }, "amount": { "type": "string" }, "big": { "type": "string" }, "small": { "type": "string" } } } },
   "pods": { "type": "array", "items": { "type": "object", "required": ["big", "small", "well", "mat", "isNew"], "additionalProperties": false, "properties": { "big": { "type": "string" }, "small": { "type": "string" }, "well": { "type": "integer" }, "mat": { "type": "integer" }, "isNew": { "type": "boolean" } } } },
   "finds": { "type": "array", "items": { "$ref": "find" } },
   "portrait": { "type": ["object", "null"], "required": ["frame", "picture"], "additionalProperties": false, "properties": { "frame": { "type": "string" }, "picture": { "type": "string" } } } } }
 },
 "type": "object", "required": ["state", "berths", "sittingCrate", "regions", "focus"], "additionalProperties": false,
 "properties": {
  "state": { "enum": ["bay", "opening", "end", "arrival"] },
  "berths": { "enum": [3, 4] },
  "sittingCrate": { "type": ["object", "null"], "required": ["id", "mibi", "frame", "picture"], "additionalProperties": false, "properties": { "id": { "type": ["string", "integer"] }, "mibi": { "type": ["string", "integer"] }, "frame": { "type": "string" }, "picture": { "type": "string" } } },
  "regions": { "type": "object", "additionalProperties": false, "properties": {
   "bay": { "type": "object", "required": ["picture"], "additionalProperties": false, "properties": { "picture": { "type": "string" } } },
   "berths": { "type": "object", "required": ["recess", "shut", "edge", "gilt", "list"], "additionalProperties": false, "properties": { "recess": { "type": "string" }, "shut": { "type": "string" }, "edge": { "type": "string" }, "gilt": { "type": "string" }, "list": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "$ref": "berth" } } } },
   "hatch": { "type": "object", "required": ["shut", "open", "frame", "ring", "lit", "wells"], "additionalProperties": false, "properties": { "shut": { "type": "string" }, "open": { "type": "string" }, "frame": { "type": "string" }, "ring": { "type": "string" }, "lit": { "type": "string" }, "wells": { "type": "array", "maxItems": 6, "items": { "$ref": "well" } } } },
   "waiting": { "type": "object", "required": ["mat", "shadow", "pods"], "additionalProperties": false, "properties": { "mat": { "type": "string" }, "shadow": { "type": "string" }, "pods": { "type": "array", "items": { "type": "object", "required": ["pod", "from"], "additionalProperties": false, "properties": { "pod": { "type": "string" }, "from": { "$ref": "from" } } } } } },
   "opening": { "type": "object", "required": ["crate", "at", "base", "starts", "lens", "crates"], "additionalProperties": false, "properties": { "crate": { "type": "integer" }, "at": { "type": "integer" }, "base": { "type": "integer" }, "starts": { "type": "array", "items": { "type": "integer" } }, "lens": { "type": "array", "items": { "type": "integer" } }, "shadowBig": { "type": "string" }, "shadowSmall": { "type": "string" }, "glint": { "type": "string" }, "crates": { "type": "array", "items": { "$ref": "crate" } } } },
   "dockBay": { "type": "object", "required": ["state", "open", "door"], "additionalProperties": false, "properties": { "state": { "enum": ["open", "shut"] }, "open": { "type": "string" }, "door": { "type": "string" } } },
   "dockCrates": { "type": "object", "required": ["places", "shadow"], "additionalProperties": false, "properties": { "places": { "type": "array", "items": { "type": "string" } }, "shadow": { "type": "string" } } },
   "dockRack": { "type": "object", "required": ["insert", "wells"], "additionalProperties": false, "properties": { "insert": { "type": "string" }, "wells": { "type": "array", "items": { "type": "object", "required": ["pod"], "additionalProperties": false, "properties": { "pod": { "type": "string" } } } } } },
   "arrival": { "type": "object", "required": ["phase", "at", "ribbon", "apron", "light", "glint", "glints", "mibis", "plates", "leaving"], "additionalProperties": false, "properties": { "phase": { "enum": ["show", "choice"] }, "at": { "type": "integer" }, "ribbon": { "type": "string" }, "apron": { "type": "string" }, "light": { "type": "string" }, "glint": { "type": "string" }, "glints": { "type": "array", "items": { "type": "boolean" } }, "mibis": { "type": "array", "maxItems": 3, "items": { "type": "string" } }, "plates": { "type": "object", "required": ["icon", "max", "whole", "mended", "words"], "additionalProperties": false, "properties": { "icon": { "type": "string" }, "max": { "type": "integer" }, "whole": { "type": "integer" }, "mended": { "type": "integer" }, "words": { "type": "string" } } }, "leaving": { "type": "object", "required": ["mark", "faces"], "additionalProperties": false, "properties": { "mark": { "type": "string" }, "faces": { "type": "array", "maxItems": 3, "items": { "type": "string" } } } } } }
  } },
  "focus": { "type": "object", "required": ["cur", "targets"], "additionalProperties": false, "properties": { "cur": { "enum": ["room"] }, "targets": { "type": "array" } } }
 }
}
