{
 "$comment": "The props of Pods (lvgl-switch.md §2.1): what views/pods-props.mjs gives the face, beside the frame's. Props name what, never where: strings, states, counts, asset ids, flags and the focus targets by id; no rectangle, no measure, no layout rule, no colour (the words read those from pods.json and the palette). An asset id names a picture the host has made ready (the view's `requests` list them); a picture the face does not hold draws nothing. Checked by prototypes/station/tests/pods-props.test.mjs (a JSON-Schema subset: type, properties, required, additionalProperties, items, enum, oneOf).",
 "$defs": {
  "id": { "type": "string" },
  "idOrNull": { "type": ["string", "null"] },
  "target": { "type": "object", "required": ["id", "group"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "group": { "type": "string" }, "index": { "type": "integer" }, "enabled": { "type": "boolean" } } },
  "place": { "oneOf": [
   { "type": "object", "required": ["empty", "panel", "ringLayers"], "additionalProperties": false, "properties": { "empty": { "enum": [true] }, "panel": { "type": "string" }, "ringLayers": { "type": "array", "items": { "type": "string" } } } },
   { "type": "object", "required": ["panel", "ringLayers", "pod", "name", "plate", "find", "grow", "glint"], "additionalProperties": false, "properties": { "panel": { "type": "string" }, "ringLayers": { "type": "array", "items": { "type": "string" } }, "pod": { "type": "string" }, "name": { "type": "string" }, "plate": { "type": "string" }, "find": { "type": ["string", "null"] }, "grow": { "type": ["string", "null"] }, "glint": { "type": ["string", "null"] } } } ] },
  "tab": { "type": "object", "required": ["id", "word", "state", "pips", "filled", "glint", "emblem"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "word": { "type": "string" }, "state": { "enum": ["unread", "read", "sealed"] }, "pips": { "type": "integer" }, "filled": { "type": "integer" }, "glint": { "type": "boolean" }, "emblem": { "type": "string" } } },
  "cell": { "type": "object", "required": ["name", "lines", "glyphs", "diff", "isNew"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "lines": { "type": "array", "items": { "type": "string" } }, "glyphs": { "type": "array", "items": { "type": "object", "required": ["key", "asset"], "additionalProperties": false, "properties": { "key": { "enum": ["hides", "blend", "only", "asleep", "doing"] }, "asset": { "type": "string" } } } }, "diff": { "type": "boolean" }, "isNew": { "type": "boolean" }, "frost": { "type": "boolean" }, "outline": { "type": ["string", "null"] }, "crop": { "type": "string" }, "wipeMilli": { "type": "integer" } } },
  "page": { "type": "object", "required": ["region", "heading", "cells", "differs", "count", "sealedFind", "sealedPicture", "newMark", "overflow"], "additionalProperties": false, "properties": {
   "region": { "type": "string" }, "pane": { "type": ["string", "null"] },
   "heading": { "oneOf": [ { "type": "null" }, { "type": "object", "required": ["emblem", "word"], "additionalProperties": false, "properties": { "emblem": { "type": "string" }, "word": { "type": "string" } } }, { "type": "object", "required": ["pod", "who"], "additionalProperties": false, "properties": { "pod": { "type": "string" }, "who": { "type": "array", "items": { "type": ["string", "null"] } } } } ] },
   "cells": { "type": "array", "items": { "$ref": "cell" } }, "differs": { "type": ["string", "null"] }, "count": { "type": "integer" }, "sealedFind": { "type": ["boolean", "null"] }, "sealedPicture": { "type": ["string", "null"] }, "newMark": { "type": ["string", "null"] }, "overflow": { "type": "boolean" } } }
 },
 "type": "object", "required": ["state", "regions", "focus"], "additionalProperties": false,
 "properties": {
  "state": { "enum": ["collection", "overview", "chapter", "compare"] },
  "regions": { "type": "object", "additionalProperties": false, "required": ["bench"], "properties": {
   "bench": { "type": "object", "required": ["room"], "additionalProperties": false, "properties": { "room": { "type": "array", "items": { "type": "string" } } } },
   "list": { "type": "object", "required": ["places", "waiting"], "additionalProperties": false, "properties": { "places": { "type": "array", "items": { "$ref": "place" } }, "waiting": { "type": ["string", "null"] } } },
   "specimen": { "type": "object", "required": ["beam", "room", "pod", "cutMilli", "name", "origin", "ribbon"], "additionalProperties": false, "properties": {
    "beam": { "type": "string" }, "room": { "type": "object", "required": ["shelf", "cradle", "cradleFront", "shadow", "plate"], "additionalProperties": false, "properties": { "shelf": { "type": "string" }, "cradle": { "type": "string" }, "cradleFront": { "type": "string" }, "shadow": { "type": "string" }, "plate": { "type": "string" } } },
    "pod": { "type": "object", "required": ["sizeClass", "sealed", "identified"], "additionalProperties": false, "properties": { "sizeClass": { "enum": ["large", "medium", "small"] }, "sealed": { "type": "string" }, "identified": { "type": ["string", "null"] } } },
    "cutMilli": { "type": ["integer", "null"] }, "name": { "type": "string" }, "origin": { "type": "array", "items": { "type": "string" } }, "ribbon": { "type": ["string", "null"] },
    "captions": { "type": "object", "required": ["pod", "figure"], "additionalProperties": false, "properties": { "pod": { "type": "string" }, "figure": { "type": ["string", "null"] } } },
    "figure": { "type": "string" }, "who": { "type": "array", "items": { "type": ["string", "null"] } }, "originPicture": { "type": ["string", "null"] } } },
   "rail": { "type": ["object", "null"], "required": ["focused", "open", "star", "tabs"], "additionalProperties": false, "properties": { "focused": { "type": ["integer", "null"] }, "open": { "type": "integer" }, "star": { "type": "string" }, "current": { "type": "integer" }, "tabs": { "type": "array", "items": { "$ref": "tab" } } } },
   "page": { "oneOf": [ { "type": "null" }, { "$ref": "page" } ] }, "pageA": { "$ref": "page" }, "pageB": { "$ref": "page" },
   "stamp": { "type": ["object", "null"], "required": ["size", "asset", "case"], "additionalProperties": false, "properties": { "size": { "type": "integer" }, "asset": { "type": "string" }, "case": { "type": "object", "required": ["back", "front"], "additionalProperties": false, "properties": { "back": { "type": "string" }, "front": { "type": "string" } } } } },
   "kin": { "type": "array", "items": { "type": "object", "required": ["id", "ring", "pod"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "ring": { "type": "string" }, "pod": { "type": "string" } } } },
   "hatch": { "type": ["string", "null"] } } },
  "focus": { "type": "object", "required": ["cur", "armed", "targets", "resolve"], "additionalProperties": false, "properties": { "cur": { "type": ["string", "null"] }, "armed": { "type": "boolean" }, "targets": { "type": "array", "items": { "$ref": "target" } }, "resolve": { "type": "object", "additionalProperties": { "type": ["string", "null"] } } } }
 }
}
