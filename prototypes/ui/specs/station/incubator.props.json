{
 "$comment": "The props of the Incubator, the painted capsule (T-20261016-222; lvgl-switch.md section 2.1): what views/incubator-props.mjs gives the face, beside the frame's. Props name what, never where: the state, counts, strings, flags, asset ids and picture sizes and anchors; no rectangle, no measure, no layout rule, no colour (the words read those from incubator.json and the palette). The capsule's layers are named in every state (the face keeps its nodes); the empty state names no pod, stamp or code. A relit picture is relit:{species}:{variant}:{light}:{w}x{h}:v{recipe} (station/src/relight.mjs).",
 "$defs": {
  "pic": { "type": "string" },
  "size": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 }
 },
 "type": "object", "required": ["state", "regions", "focus"], "additionalProperties": false,
 "properties": {
  "state": { "enum": ["empty", "growing", "ready", "hatch"] },
  "regions": { "type": "object", "required": ["bench", "room", "capsule"], "additionalProperties": false, "properties": {
   "bench": { "type": "object", "additionalProperties": false, "properties": {} },
   "room": { "type": "object", "required": ["day", "dusk"], "additionalProperties": false, "properties": { "day": { "$ref": "pic" }, "dusk": { "$ref": "pic" } } },
   "capsule": { "type": "object", "required": ["interior", "shell", "door", "bar", "seal", "glass", "barPx"], "additionalProperties": false, "properties": {
     "interior": { "type": "object", "required": ["day", "dusk"], "additionalProperties": false, "properties": { "day": { "$ref": "pic" }, "dusk": { "$ref": "pic" } } },
     "shell": { "type": "object", "required": ["day", "dusk"], "additionalProperties": false, "properties": { "day": { "$ref": "pic" }, "dusk": { "$ref": "pic" } } },
     "door": { "$ref": "pic" }, "bar": { "$ref": "pic" }, "seal": { "$ref": "pic" }, "glass": { "$ref": "pic" },
     "barPx": { "type": "integer", "minimum": 0, "maximum": 158, "description": "the lit width of the bar in px: floor(158 x progress) while growing, 158 when ready and in the hatch" } } },
   "inside": { "type": "object", "required": ["pod", "opened"], "additionalProperties": false, "properties": {
     "pod": { "type": "object", "required": ["day", "dusk", "crack"], "additionalProperties": false, "properties": { "day": { "$ref": "pic" }, "dusk": { "$ref": "pic" }, "crack": { "$ref": "pic" } } },
     "opened": { "$ref": "pic" } } },
   "stamp": { "type": "object", "required": ["case", "size", "N", "cell", "plate", "asset"], "additionalProperties": false, "properties": { "case": { "type": "object", "required": ["back", "front"], "additionalProperties": false, "properties": { "back": { "$ref": "pic" }, "front": { "$ref": "pic" } } }, "size": { "type": "integer" }, "N": { "type": "integer" }, "cell": { "type": "integer" }, "plate": { "type": "string" }, "asset": { "$ref": "pic" } } },
   "code": { "type": "string" },
   "readyIn": { "type": "string" },
   "juvenile": { "type": "object", "required": ["picture", "size", "anchor"], "additionalProperties": false, "properties": { "picture": { "$ref": "pic" }, "size": { "$ref": "size" }, "anchor": { "$ref": "size" } } },
   "ribbon": { "type": "string" }
  } },
  "focus": { "type": "object", "required": ["cur", "targets"], "additionalProperties": false, "properties": { "cur": { "const": "room" }, "targets": { "type": "array", "maxItems": 0 } } }
 }
}
