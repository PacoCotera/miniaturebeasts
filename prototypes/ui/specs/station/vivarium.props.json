{
 "$comment": "The props of the Vivarium (the collection v2 design; lvgl-switch.md §2.1): what views/vivarium-props.mjs gives the face, beside the frame's. Props name what, never where: ids, strings, states, seeds, flags and the focus targets by id; no rectangle, no measure, no layout rule, no colour (the words read those from vivarium.json, rooms.json and the palette). Pictures are ids. regions.window.edge is the layout check's fact (layout.given: the room's crop, its painting's size, its keep forms and joins in painting coordinates), never drawn from.",
 "$defs": {
  "person": {
   "type": "object",
   "required": [
    "id",
    "name",
    "stage",
    "picture",
    "waiting",
    "seed"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "stage": {
     "enum": [
      "juvenile",
      "adult",
      "elder"
     ]
    },
    "picture": {
     "type": "string"
    },
    "waiting": {
     "type": "boolean"
    },
    "curl": {
     "type": "string",
     "description": "T-20261018-235: the sleeping resident's curl picture, set while its rest is asleep and it has a curl"
    },
    "curlFigure": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "minItems": 4,
     "maxItems": 4,
     "description": "[dx, dy, W, H] of the curl in its picture: the ring and the tag of a sleeping resident are measured from it"
    },
    "seed": {
     "type": "integer"
    },
    "moving": {
     "oneOf": [
      {
       "enum": [
        ""
       ]
      },
      {
       "type": "object",
       "required": [
        "set",
        "walk",
        "shadow"
       ],
       "additionalProperties": false,
       "properties": {
        "set": {
         "type": "string"
        },
        "walk": {
         "type": "string"
        },
        "shadow": {
         "type": "string"
        }
       }
      },
      {
       "type": "object",
       "required": [
        "set",
        "nap"
       ],
       "additionalProperties": false,
       "properties": {
        "set": {
         "type": "string"
        },
        "nap": {
         "type": "string"
        }
       }
      }
     ],
     "description": "Station M1 §2.2: \"\" (a still, main's walk) or the atlases of its moving set (the walk and its shadow; a bed sleeper its nap); the face never makes an id"
    },
    "rest": {
     "enum": [
      "awake",
      "asleep"
     ],
     "description": "Station M1 §2.6: by restOf (the rest stagger) from the Station time"
    },
    "figure": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "minItems": 4,
     "maxItems": 4,
     "description": "T-20261018-235: [dx, dy, W, H], the drawn bbox of the figure (ink alpha >= 128, its contact shadow left out) in its picture; the geometry of the ring, the tag, the walk and the keep-out is measured from it. Absent: the picture is the figure"
    },
    "shown": {
     "type": "boolean",
     "description": "R4b (vivarium.json rules.show): false for a rester, one of the housed that the room does not show; absent: shown. A rester finishes its trip, then rests where restAt says; N for the raised cap and the travelling ceiling counts the shown only"
    },
    "restAt": {
     "enum": [
      "bed",
      "curl",
      "out"
     ],
     "description": "R4b: where a rester rests, in the order rules.show.where gives: the bed (it is also in bed.sleepers), a curl in a nice spot (its curl and curlFigure given), or out of sight off the room's rest edge"
    },
    "enter": {
     "enum": [
      "edge"
     ],
     "description": "R4b: a traveller home since the walk began: it walks in from the room's rest edge (rooms.json rest.edge); honoured only while a walk is running"
    },
    "rester": {
     "type": "boolean",
     "description": "R4b: a bed sleeper that is a rester (the bed is the nappers' alone)"
    },
    "mark": {
     "type": "string",
     "description": "the collection v2 design §6: the master of its one mark on the figure (the asleep mark, the heart, the stick; the lamp for a coming-out silhouette), absent when none applies"
    },
    "carried": {
     "type": "boolean",
     "description": "§3: the one in hand, in its own room: it pauses where it stands (its point's silhouette while the hand is elsewhere)"
    }
   }
  },
  "target": {
   "type": "object",
   "required": [
    "id",
    "group"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string"
    },
    "group": {
     "enum": [
      "resident",
      "hand",
      "room",
      "plate",
      "house",
      "flipprev",
      "flipnext"
     ]
    },
    "index": {
     "type": "integer"
    },
    "enabled": {
     "type": "boolean"
    }
   }
  },
  "chip": {
   "type": "object",
   "required": [
    "id",
    "kind",
    "name",
    "count",
    "full",
    "lit",
    "picture"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "description": "a room's number (0 to 3), new (Add a room), all (All rooms) or tucked (Tucked away)"
    },
    "kind": {
     "enum": [
      "room",
      "new",
      "all",
      "tucked"
     ]
    },
    "name": {
     "type": "string"
    },
    "count": {
     "type": "string",
     "description": "a room's \"{a} of 8\" or \"full\"; Add a room its price; Tucked away its count; \"\" for All rooms"
    },
    "full": {
     "type": "boolean"
    },
    "lit": {
     "type": "boolean",
     "description": "the chip naming the view shown (its 2 px bone underline)"
    },
    "picture": {
     "type": "string",
     "description": "a room's 128 x 32 chip cut in the light (rooms.json chip); the cold mark on Tucked away; \"\" otherwise"
    }
   }
  },
  "plate": {
   "type": "object",
   "required": [
    "id",
    "verb",
    "price",
    "held"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string"
    },
    "verb": {
     "type": "string"
    },
    "price": {
     "type": "string"
    },
    "held": {
     "type": "boolean"
    }
   }
  },
  "card": {
   "type": "object",
   "required": [
    "state",
    "name",
    "looks",
    "mark",
    "words",
    "picture",
    "plates",
    "why"
   ],
   "additionalProperties": false,
   "properties": {
    "state": {
     "enum": [
      "mibi",
      "empty",
      "none"
     ]
    },
    "id": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "looks": {
     "type": "array",
     "maxItems": 3,
     "items": {
      "type": "string"
     }
    },
    "mark": {
     "type": "string"
    },
    "words": {
     "type": "string"
    },
    "picture": {
     "type": "string"
    },
    "figure": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "minItems": 4,
     "maxItems": 4
    },
    "plates": {
     "type": "array",
     "maxItems": 6,
     "items": {
      "$ref": "plate"
     }
    },
    "why": {
     "type": "string"
    }
   }
  },
  "place": {
   "type": "object",
   "required": [
    "id",
    "state",
    "picture",
    "mark"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string"
    },
    "state": {
     "enum": [
      "mibi",
      "carried",
      "coming",
      "store",
      "free",
      "more"
     ]
    },
    "picture": {
     "type": "string"
    },
    "mark": {
     "type": "string"
    },
    "more": {
     "type": "string"
    }
   }
  },
  "band": {
   "type": "object",
   "required": [
    "kind",
    "name",
    "full",
    "places"
   ],
   "additionalProperties": false,
   "properties": {
    "kind": {
     "enum": [
      "room",
      "add",
      "later",
      "cold"
     ]
    },
    "name": {
     "type": "string"
    },
    "price": {
     "type": "string"
    },
    "count": {
     "type": "string"
    },
    "mark": {
     "type": "string"
    },
    "full": {
     "type": "boolean"
    },
    "places": {
     "type": "array",
     "maxItems": 8,
     "items": {
      "$ref": "place"
     }
    }
   }
  },
  "cold": {
   "type": "object",
   "required": [
    "id",
    "name",
    "picture",
    "figure"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "picture": {
     "type": "string"
    },
    "figure": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "minItems": 4,
     "maxItems": 4
    }
   }
  },
  "reserved": {
   "type": "object",
   "required": [
    "id",
    "name",
    "spot",
    "picture",
    "figure",
    "mark"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "spot": {
     "type": "integer"
    },
    "picture": {
     "type": "string"
    },
    "figure": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "minItems": 4,
     "maxItems": 4
    },
    "mark": {
     "type": "string"
    }
   }
  },
  "form": {
   "type": "object",
   "required": [
    "id",
    "form"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string"
    },
    "form": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "minItems": 4,
     "maxItems": 4
    },
    "leaves": {
     "enum": [
      "left",
      "top",
      "right",
      "bottom"
     ]
    }
   }
  }
 },
 "type": "object",
 "required": [
  "state",
  "view",
  "regions",
  "focus"
 ],
 "additionalProperties": false,
 "properties": {
  "state": {
   "enum": [
    "rest",
    "empty"
   ]
  },
  "view": {
   "enum": [
    "room",
    "house",
    "tucked"
   ]
  },
  "regions": {
   "type": "object",
   "required": [
    "window",
    "rooms",
    "card"
   ],
   "additionalProperties": false,
   "properties": {
    "window": {
     "type": "object",
     "required": [
      "picture"
     ],
     "additionalProperties": false,
     "properties": {
      "picture": {
       "type": "string"
      },
      "edge": {
       "type": "object",
       "required": [
        "crop",
        "painting",
        "keep",
        "joins"
       ],
       "additionalProperties": false,
       "properties": {
        "crop": {
         "type": "array",
         "items": {
          "type": "integer"
         },
         "minItems": 2,
         "maxItems": 2
        },
        "painting": {
         "type": "array",
         "items": {
          "type": "integer"
         },
         "minItems": 2,
         "maxItems": 2
        },
        "keep": {
         "type": "array",
         "items": {
          "$ref": "form"
         }
        },
        "joins": {
         "type": "array",
         "items": {
          "$ref": "form"
         }
        }
       }
      }
     }
    },
    "room": {
     "type": "object",
     "required": [
      "id",
      "base",
      "pieces"
     ],
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string",
       "description": "the room shown: its name in rooms.json (roots, reeds, boulders, ferns)"
      },
      "base": {
       "type": "string",
       "description": "the room's painting (the near view in Habitat) in the light"
      },
      "pieces": {
       "type": "object",
       "description": "the room's pieces that have a picture, by piece id (rooms.json), the picture id in the light; Habitat has none"
      }
     }
    },
    "residents": {
     "type": "array",
     "maxItems": 12,
     "items": {
      "$ref": "person"
     }
    },
    "bed": {
     "type": "object",
     "required": [
      "state",
      "picture",
      "sleepers"
     ],
     "additionalProperties": false,
     "properties": {
      "state": {
       "enum": [
        "empty",
        "resting"
       ]
      },
      "picture": {
       "type": "string"
      },
      "sleepers": {
       "type": "array",
       "maxItems": 3,
       "items": {
        "$ref": "person"
       }
      }
     },
     "description": "given only when the room has a bed (Roots)"
    },
    "drops": {
     "type": "object",
     "required": [
      "items"
     ],
     "additionalProperties": false,
     "properties": {
      "items": {
       "type": "array",
       "maxItems": 8,
       "items": {
        "type": "integer"
       },
       "description": "the drop spots shown while a mibi is in hand: indexes into rooms.json drops"
      }
     }
    },
    "reserved": {
     "type": "object",
     "required": [
      "items"
     ],
     "additionalProperties": false,
     "properties": {
      "items": {
       "type": "array",
       "maxItems": 8,
       "items": {
        "$ref": "reserved"
       }
      }
     }
    },
    "rooms": {
     "type": "object",
     "required": [
      "items"
     ],
     "additionalProperties": false,
     "properties": {
      "items": {
       "type": "array",
       "maxItems": 7,
       "items": {
        "$ref": "chip"
       }
      }
     }
    },
    "card": {
     "$ref": "card"
    },
    "house": {
     "type": "object",
     "required": [
      "bands"
     ],
     "additionalProperties": false,
     "properties": {
      "bands": {
       "type": "array",
       "maxItems": 5,
       "items": {
        "$ref": "band"
       }
      }
     }
    },
    "tucked": {
     "type": "object",
     "required": [
      "page",
      "pages",
      "items",
      "here"
     ],
     "additionalProperties": false,
     "properties": {
      "page": {
       "type": "integer"
      },
      "pages": {
       "type": "integer"
      },
      "items": {
       "type": "array",
       "maxItems": 8,
       "items": {
        "$ref": "cold"
       }
      },
      "here": {
       "type": "boolean"
      }
     }
    },
    "carry": {
     "type": "object",
     "required": [
      "id",
      "name",
      "own",
      "picture",
      "figure",
      "outline",
      "mark"
     ],
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "own": {
       "type": "boolean"
      },
      "picture": {
       "type": "string"
      },
      "figure": {
       "type": "array",
       "items": {
        "type": "integer"
       },
       "minItems": 4,
       "maxItems": 4
      },
      "outline": {
       "type": "string"
      },
      "mark": {
       "type": "string"
      }
     }
    },
    "pick": {
     "type": "object",
     "required": [
      "id"
     ],
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      }
     }
    }
   }
  },
  "focus": {
   "type": "object",
   "required": [
    "cur",
    "targets",
    "resolve"
   ],
   "additionalProperties": false,
   "properties": {
    "cur": {
     "type": "string"
    },
    "targets": {
     "type": "array",
     "items": {
      "$ref": "target"
     }
    },
    "resolve": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    }
   }
  }
 }
}
