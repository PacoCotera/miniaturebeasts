{
 "$comment": "The props of the Vivarium's whole (lvgl-switch.md §2.1): what views/vivarium-props.mjs gives the face, beside the frame's. Props name what, never where: ids, strings, states, seeds, flags and the focus targets by id; no rectangle, no measure, no layout rule, no colour (the words read those from vivarium.json and the palette). Pictures are ids; the window's is a slot (empty until the whole's painting is placed, then the plates stand).",
 "$defs": {
  "person": {
   "type": "object",
   "required": [
    "id",
    "name",
    "stage",
    "picture",
    "waiting",
    "seed"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "stage": {
     "enum": [
      "juvenile",
      "adult",
      "elder"
     ]
    },
    "picture": {
     "type": "string"
    },
    "waiting": {
     "type": "boolean"
    },
    "seed": {
     "type": "integer"
    }
   }
  },
  "tile": {
   "type": "object",
   "required": [
    "id",
    "state",
    "picture"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string"
    },
    "state": {
     "enum": [
      "housed",
      "out",
      "free"
     ]
    },
    "picture": {
     "type": "string"
    }
   }
  },
  "target": {
   "type": "object",
   "required": [
    "id",
    "group"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string"
    },
    "group": {
     "enum": [
      "resident",
      "tile"
     ]
    },
    "enabled": {
     "type": "boolean"
    }
   }
  }
 },
 "type": "object",
 "required": [
  "state",
  "regions",
  "focus"
 ],
 "additionalProperties": false,
 "properties": {
  "state": {
   "enum": [
    "rest",
    "empty"
   ]
  },
  "regions": {
   "type": "object",
   "required": [
    "window",
    "residents",
    "bed",
    "tiles"
   ],
   "additionalProperties": false,
   "properties": {
    "window": {
     "type": "object",
     "required": [
      "picture"
     ],
     "additionalProperties": false,
     "properties": {
      "picture": {
       "type": "string"
      }
     }
    },
    "residents": {
     "type": "array",
     "maxItems": 12,
     "items": {
      "$ref": "person"
     }
    },
    "bed": {
     "type": "object",
     "required": [
      "state",
      "picture",
      "mark",
      "sleepers"
     ],
     "additionalProperties": false,
     "properties": {
      "state": {
       "enum": [
        "docked",
        "away",
        "none"
       ]
      },
      "picture": {
       "type": "string"
      },
      "mark": {
       "type": "string"
      },
      "sleepers": {
       "type": "array",
       "maxItems": 3,
       "items": {
        "$ref": "person"
       }
      }
     }
    },
    "tiles": {
     "type": "object",
     "required": [
      "glyph",
      "items"
     ],
     "additionalProperties": false,
     "properties": {
      "glyph": {
       "type": "string"
      },
      "items": {
       "type": "array",
       "maxItems": 12,
       "items": {
        "$ref": "tile"
       }
      }
     }
    }
   }
  },
  "focus": {
   "type": "object",
   "required": [
    "cur",
    "targets",
    "resolve"
   ],
   "additionalProperties": false,
   "properties": {
    "cur": {
     "type": "string"
    },
    "targets": {
     "type": "array",
     "items": {
      "$ref": "target"
     }
    },
    "resolve": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    }
   }
  }
 }
}
